@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ApiClient Api
@inject AuthService Auth
@inject HttpClient Http

<div class="admin-shell @(_collapsed ? "collapsed" : "")">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin/dashboard"><span>◆</span><span class="brand-text">AttendIQ Admin</span></a>
        <nav class="nav-list">
            @NavItem("/admin/dashboard", "▦", "Самбар")
            @NavItem("/admin/employees", "☷", "Ажилтнууд")
            @NavItem("/admin/attendance", "◷", "Ирц")
            @NavItem("/admin/leave", "☑", "Чөлөө")
            @NavItem("/admin/reports", "▤", "Тайлан")
        </nav>
        <div class="sidebar-bottom">
            <div class="admin-brand">
                <span class="avatar" style="width:38px;height:38px;background:rgba(255,255,255,.16)">@GetInitial()</span>
                <div>
                    <h3 style="margin:0">@(_displayName)</h3>
                    <div class="muted">@(_displayRole)</div>
                </div>
            </div>
            <button class="btn btn-logout mt-3" @onclick="LogoutAsync" disabled="@isLoggingOut">
                @if (isLoggingOut)
                {
                    <span>Гарч байна...</span>
                }
                else
                {
                    <span>🚪 Гарах</span>
                }
            </button>
            <button class="collapse-btn" @onclick="() => _collapsed = !_collapsed">@(_collapsed ? "→" : "←")</button>
        </div>
    </aside>
    <div class="admin-main">
        <header class="admin-topbar">
            <strong>@Breadcrumb</strong>
            <div class="action-row"><NotificationBell /><span class="avatar" style="width:38px;height:38px;background:var(--clr-primary-light);color:var(--clr-primary)">@GetInitial()</span></div>
        </header>
        <main class="content-wrap">@Body</main>
    </div>
</div>

@code {
    private bool _collapsed;
    private bool isLoggingOut;
    private string _displayName = "Admin";
    private string _displayRole = "Administrator";

    protected override async Task OnInitializedAsync()
    {
        // ApiClient ашиглахгүй — 401 бол автоматаар logout хийдэг тул
        // Шууд HttpClient ашиглаж, токен гараар нэмж, 401-ийг чимээгүй алгасна
        try
        {
            var token = await Auth.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
                return;

            // Токеноос нэр болон role уншина (API дуудалгүйгээр)
            var (name, role) = ParseTokenClaims(token);
            if (!string.IsNullOrWhiteSpace(name))
                _displayName = name;
            if (!string.IsNullOrWhiteSpace(role))
                _displayRole = role;

            // Employee profile байвал нэмж татна (SuperAdmin-д байхгүй — зүгээр)
            using var request = new System.Net.Http.HttpRequestMessage(
                System.Net.Http.HttpMethod.Get, "api/employees/me");
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var profile = await response.Content
                    .ReadFromJsonAsync<EmployeeProfileApiDto>();
                if (profile is not null)
                {
                    _displayName = profile.FullName;
                    _displayRole = profile.Department ?? _displayRole;
                }
            }
            // 401 → SuperAdmin-д employee profile байхгүй нь нормал, алгасна
        }
        catch
        {
            // Ямар ч алдаа гарсан layout ажилласаар байна
        }
    }

    // JWT payload-аас нэр болон role-ийг унших (API дуудалгүйгээр)
    private static (string Name, string Role) ParseTokenClaims(string jwt)
    {
        try
        {
            var parts = jwt.Split('.');
            if (parts.Length < 2) return ("", "");

            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));

            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            var name = "";
            var role = "";

            if (root.TryGetProperty("email", out var emailProp))
                name = emailProp.GetString() ?? "";

            foreach (var key in new[] { "role", "roles",
                "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" })
            {
                if (!root.TryGetProperty(key, out var roleProp)) continue;

                if (roleProp.ValueKind == System.Text.Json.JsonValueKind.String)
                    role = roleProp.GetString() ?? "";
                else if (roleProp.ValueKind == System.Text.Json.JsonValueKind.Array)
                    role = roleProp.EnumerateArray()
                        .FirstOrDefault().GetString() ?? "";
                break;
            }

            return (name, role);
        }
        catch { return ("", ""); }
    }

    private string Breadcrumb => Nav.Uri.Contains("/admin/", StringComparison.OrdinalIgnoreCase)
        ? "Admin / " + Nav.Uri.Split('/').Last()
        : "Admin";

    private RenderFragment NavItem(string href, string icon, string label) =>
        @<a class="nav-link @(Nav.Uri.Contains(href, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
            href="@href"><span>@icon</span><span class="nav-label">@label</span></a>;

    private async Task LogoutAsync()
    {
        isLoggingOut = true;
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    private string GetInitial()
    {
        if (!string.IsNullOrWhiteSpace(_displayName))
        {
            var parts = _displayName.Split(new[] { ' ', '@' },
                StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
                : parts[0][0].ToString().ToUpperInvariant();
        }
        return "A";
    }

    // Employee profile API response — EmployeesApiController.cs-тэй таарна
    private sealed record EmployeeProfileApiDto(
        Guid Id,
        string? ProfilePhotoUrl,
        string EmployeeCode,
        string FullName,
        string Email,
        string? Phone,
        DateOnly? DateOfBirth,
        string? Department,
        string? DepartmentName,
        string? Position,
        DateOnly HireDate,
        string? EmploymentStatus,
        string? Status,
        bool IsActive);
}
