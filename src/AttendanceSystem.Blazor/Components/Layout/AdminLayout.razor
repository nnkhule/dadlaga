@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ApiClient Api
@inject AuthService Auth
@inject HttpClient Http

<div class="admin-shell @(_collapsed ? "collapsed" : "")">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin/dashboard">
            <span>◆</span>
            <span class="brand-text">AttendIQ Admin</span>
        </a>

        <nav class="nav-list">
            @NavItem("/admin/dashboard",  "▦",  "Самбар")
            @NavItem("/admin/employees",  "☷",  "Ажилтнууд")
            @NavItem("/admin/attendance", "◷",  "Ирц")
            @NavItem("/admin/leave",      "☑",  "Чөлөө")
            @NavItem("/admin/reports",    "▤",  "Тайлан")
            @NavItem("/admin/ai-chat",    "🤖", "AI Assistant")
        </nav>

        <div class="sidebar-bottom">
            <div class="admin-brand">
                <span class="avatar" style="width:38px;height:38px;background:rgba(255,255,255,.16)">@GetInitial()</span>
                <div class="brand-text">
                    @if (profile is null)
                    {
                        <h3 style="margin:0">@_displayName.Split(' ').Select(s => s.Substring(0, 5)).Aggregate((a, b) => a + b)</h3>
                        <span class="badge badge-leave" style="margin-top:4px">--</span>
                    }
                    else
                    {
                        <h3 style="margin:0">@profile.FullName</h3>
                        <span class="badge badge-leave" style="margin-top:4px">@Display(profile.Department ?? profile.DepartmentName)</span>
                    }
                </div>
            </div>

            <button class="btn btn-logout brand-text" style="margin-top:12px;width:100%"
                    @onclick="LogoutAsync" disabled="@isLoggingOut">
                @if (isLoggingOut) { <span>Гарч байна...</span> }
                else               { <span>🚪 Гарах</span>      }
            </button>

            <button class="collapse-btn" style="margin-top:8px"
                    @onclick="() => _collapsed = !_collapsed">
                @(_collapsed ? "→" : "←")
            </button>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <strong>@Breadcrumb</strong>
            <div class="action-row">
                <NotificationBell />
                <span class="avatar"
                      style="width:38px;height:38px;background:var(--clr-primary-light);color:var(--clr-primary)">
                    @GetInitial()
                </span>
            </div>
        </header>
        <main class="content-wrap">@Body</main>
    </div>

    <nav class="mobile-bottom-nav">
        @MobileItem("/admin/dashboard",  "▦", "Самбар")
        @MobileItem("/admin/attendance", "◷", "Ирц")
        @MobileItem("/admin/leave",      "☑", "Чөлөө")
        @MobileItem("/admin/ai-chat",   "🤖", "AI")
        @MobileItem("/admin/employees",  "☷", "Ажилтан")
    </nav>
</div>

<style>
.btn-logout {
    padding: 8px 12px;
    border: 1px solid rgba(255,255,255,.4);
    background: transparent;
    color: rgba(255,255,255,.85);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all .2s ease;
}
.btn-logout:hover:not(:disabled) {
    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.7);
    color: #fff;
}
.btn-logout:disabled { opacity: .6; cursor: not-allowed; }
</style>

@code {
    private bool _collapsed;
    private bool isLoggingOut;
    private string _displayName = "Admin";
    private string _displayRole = "Administrator";
    private EmployeeProfileApiDto? profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var token = await Auth.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token)) return;

            var (name, role) = ParseTokenClaims(token);
            if (!string.IsNullOrWhiteSpace(name)) _displayName = name;
            if (!string.IsNullOrWhiteSpace(role)) _displayRole = role;

            using var request = new System.Net.Http.HttpRequestMessage(
                System.Net.Http.HttpMethod.Get, "api/employees/me");
            request.Headers.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                profile = await response.Content.ReadFromJsonAsync<EmployeeProfileApiDto>();
                if (profile is not null)
                {
                    _displayName = profile.FullName;
                    _displayRole = profile.Department ?? _displayRole;
                }
            }
        }
        catch { /* layout ажилласаар байна */ }
    }

    private RenderFragment NavItem(string href, string icon, string label) => @<a
        class="nav-link @(Nav.Uri.Contains(href, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
        href="@href">
        <span>@icon</span>
        <span class="nav-label">@label</span>
    </a>;

    private RenderFragment MobileItem(string href, string icon, string label) => @<a
        class="@(Nav.Uri.Contains(href, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
        href="@href">
        <span>@icon</span>
        <span>@label</span>
    </a>;

    private async Task LogoutAsync()
    {
        isLoggingOut = true;
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    private string Breadcrumb => Nav.Uri.Contains("/admin/", StringComparison.OrdinalIgnoreCase)
        ? "Admin / " + Nav.Uri.Split('/').Last()
        : "Admin";

    private string GetInitial()
    {
        if (string.IsNullOrWhiteSpace(_displayName)) return "A";
        var parts = _displayName.Split(new[] { ' ', '@' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }

    private static string Display(string? v) => string.IsNullOrWhiteSpace(v) ? "--" : v;

    private static (string Name, string Role) ParseTokenClaims(string jwt)
    {
        try
        {
            var parts = jwt.Split('.');
            if (parts.Length < 2) return ("", "");

            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            payload = payload.PadRight(payload.Length + (4 - payload.Length % 4) % 4, '=');
            var json = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(payload));

            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            var name = root.TryGetProperty("email", out var ep) ? ep.GetString() ?? "" : "";
            var role = "";
            foreach (var key in new[] {
                "role", "roles",
                "http://schemas.microsoft.com/ws/2008/06/identity/claims/role" })
            {
                if (!root.TryGetProperty(key, out var rp)) continue;
                role = rp.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? rp.EnumerateArray().FirstOrDefault().GetString() ?? ""
                    : rp.GetString() ?? "";
                break;
            }
            return (name, role);
        }
        catch { return ("", ""); }
    }

    private sealed record EmployeeProfileApiDto(
        Guid Id,
        string? ProfilePhotoUrl,
        string EmployeeCode,
        string FullName,
        string Email,
        string? Phone,
        DateOnly? DateOfBirth,
        string? Department,
        string? DepartmentName,
        string? Position,
        DateOnly HireDate,
        string? EmploymentStatus,
        string? Status,
        bool IsActive);
}
