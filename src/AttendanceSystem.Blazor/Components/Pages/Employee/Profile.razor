@page "/profile"
@layout EmployeeLayout
@inject ApiClient Api

<PageHeader Title="Профайл" Subtitle="Ажилтны хувийн мэдээлэл" Icon="◎" />

<div class="page-stack">
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="card" style="border-color:var(--clr-danger);color:var(--clr-danger)">
            @error
        </div>
    }

    @if (profile is null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="card profile-summary">
            @if (!string.IsNullOrWhiteSpace(profile.ProfilePhotoUrl))
            {
                <img class="avatar"
                     style="width:80px;height:80px;object-fit:cover"
                     src="@profile.ProfilePhotoUrl"
                     alt="" />
            }
            else
            {
                <div class="avatar"
                     style="width:80px;height:80px;background:var(--clr-primary-light);color:var(--clr-primary);font-size:26px">
                    @Initials(profile.FullName)
                </div>
            }

            <div class="profile-summary-details">
                <h2 style="margin:0">@profile.FullName</h2>
                <div class="muted">@Display(profile.Position)</div>
                <span class="badge badge-leave">
                    @Display(profile.Department ?? profile.DepartmentName)
                </span>
            </div>

            @if (!isEditing)
            {
                <button class="btn-primary"
                        @onclick="(() => isEditing = true)">
                    Профайл засах
                </button>
            }
        </div>

        @if (!isEditing)
{
    

    <div class="profile-info-card">

        <h3>Хувийн мэдээлэл</h3>

        <div class="info-row">
            <span>Ажилтны код</span>
            <strong>@profile.EmployeeCode</strong>
        </div>

        <div class="info-row">
            <span>И-мэйл</span>
            <strong>@profile.Email</strong>
        </div>

        <div class="info-row">
            <span>Утас</span>
            <strong>@Display(profile.Phone)</strong>
        </div>

        <div class="info-row">
            <span>Төрсөн огноо</span>
            <strong>@profile.DateOfBirth?.ToString("yyyy-MM-dd")</strong>
        </div>

        <div class="info-row">
            <span>Хэлтэс</span>
            <strong>@Display(profile.Department ?? profile.DepartmentName)</strong>
        </div>

        <div class="info-row">
            <span>Албан тушаал</span>
            <strong>@Display(profile.Position)</strong>
        </div>

        <div class="info-row">
            <span>Ажилд орсон огноо</span>
            <strong>@profile.HireDate.ToString("yyyy-MM-dd")</strong>
        </div>

    </div>
}
        else
        {
            <EditForm Model="@edit" OnValidSubmit="SaveAsync">
                <div class="card page-stack">

                    <h2>Профайл засах</h2>

                    <SettingsRow Label="Ажилтны код"
                                 Value="@profile.EmployeeCode" />

                    <div class="form-group">
                        <label>Бүтэн нэр</label>
                        <InputText class="form-control"
                                   @bind-Value="edit.FullName" />
                    </div>

                    <div class="form-group">
                        <label>И-мэйл</label>
                        <InputText class="form-control"
                                   @bind-Value="edit.Email" />
                    </div>

                    <div class="form-group">
                        <label>Утас</label>
                        <InputText class="form-control"
                                   @bind-Value="edit.Phone" />
                    </div>

                    <div class="form-group">
                        <label>Төрсөн огноо</label>
                        <InputDate class="form-control"
                                   @bind-Value="edit.DateOfBirth" />
                    </div>

                    <SettingsRow Label="Хэлтэс"
                                 Value="@(profile.Department ?? profile.DepartmentName)" />

                    <SettingsRow Label="Албан тушаал"
                                 Value="@profile.Position" />

                    <SettingsRow Label="Ажилд орсон огноо"
                                 Value="@profile.HireDate.ToString("yyyy-MM-dd")" />

                    <div style="display:flex;gap:10px">
                        <button class="btn-primary"
                                type="submit"
                                disabled="@saving">
                            Хадгалах
                        </button>

                        <button class="btn-ghost"
                                type="button"
                                @onclick="CancelEdit">
                            Болих
                        </button>
                    </div>

                </div>
            </EditForm>
        }
    }
</div>



<style>
.profile-card {
    background: white;
    border-radius: 20px;
    padding: 32px;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0,0,0,.08);
}

.profile-image {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
}

.avatar-circle {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: var(--clr-primary);
    color: white;
    font-size: 36px;
    font-weight: 700;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: auto;
}

.profile-card h2 {
    margin-top: 16px;
    margin-bottom: 6px;
}

.profile-position {
    color: #666;
    margin-bottom: 10px;
}

.profile-department {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: #eef4ff;
    color: var(--clr-primary);
    font-weight: 600;
}

.profile-info-card {
    background: white;
    border-radius: 20px;
    padding: 24px;
    margin-top: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,.08);
}

.profile-info-card h3 {
    margin-bottom: 20px;
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid #eee;
}

.info-row:last-child {
    border-bottom: none;
}

.mt-3 {
    margin-top: 16px;
}

.profile-summary {
    display: flex;
    align-items: center;
    gap: 18px;
}

.profile-summary-details {
    min-width: 0;
    flex: 1;
    overflow-wrap: anywhere;
}

.info-row {
    gap: 12px;
}

.info-row strong {
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: right;
}

@@media (max-width: 480px) {
    .profile-summary {
        flex-wrap: wrap;
    }

    .profile-summary-details {
        flex: 1 1 calc(100% - 100px);
    }

    .profile-summary > button {
        width: 100%;
    }

    .info-row {
        align-items: flex-start;
    }
}
</style>

@code {
    private EmployeeProfileDto? profile;
    private EditModel edit = new();

    private string? error;
    private bool saving;
    private bool isEditing;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            error = null;

            profile = await Api.GetAsync<EmployeeProfileDto>(
                "api/employees/me");

            if (profile is not null)
            {
                edit = new EditModel(
                    profile.FullName,
                    profile.Email,
                    profile.Phone,
                    profile.DateOfBirth);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            saving = true;
            error = null;

            await Api.PutAsync(
                "api/employees/me",
                new UpdateProfileDto(
                    edit.FullName,
                    edit.Email,
                    edit.Phone,
                    edit.DateOfBirth));

            await LoadAsync();

            isEditing = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void CancelEdit()
    {
        isEditing = false;

        if (profile is not null)
        {
            edit = new EditModel(
                profile.FullName,
                profile.Email,
                profile.Phone,
                profile.DateOfBirth);
        }
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "--" : value;

    private static string Initials(string value)
    {
        var parts = value.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

        return string.Concat(
            parts.Take(2).Select(p => p[0]))
            .ToUpperInvariant();
    }

    private sealed class EditModel
    {
        public EditModel()
        {
        }

        public EditModel(
            string fullName,
            string email,
            string? phone,
            DateOnly? dateOfBirth)
        {
            FullName = fullName;
            Email = email;
            Phone = phone;
            DateOfBirth = dateOfBirth;
        }

        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public DateOnly? DateOfBirth { get; set; }
    }
}