    };

    private static string ActivityIcon(string type) => type?.ToLowerInvariant() switch
    {
        "checkin" or "attendance" => "🟢",
        "checkout" => "🔵",
        "leave" => "☑",
        "employee" => "👤",
        "alert" or "warning" => "⚠",
        _ => "🔔"
    };

    private static string ActivityColor(string type) => type?.ToLowerInvariant() switch
    {
        "checkin" or "attendance" => "#16A34A",
        "checkout" => "#2563EB",
        "leave" => "#7C3AED",
        "employee" => "#D97706",
        "alert" or "warning" => "#DC2626",
        _ => "#64748B"
