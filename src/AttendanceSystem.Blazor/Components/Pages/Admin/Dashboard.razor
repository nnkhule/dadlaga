    private static string RelativeTime(DateTime value)
    {
        var diff = DateTime.Now - value;
        if (diff.TotalDays >= 1)    return $"{(int)diff.TotalDays} өдрийн өмнө";
        if (diff.TotalHours >= 1)   return $"{(int)diff.TotalHours} цагийн өмнө";
        if (diff.TotalMinutes >= 1) return $"{(int)diff.TotalMinutes} минутын өмнө";
        return "дөнгөж сая";
    }

    public ValueTask DisposeAsync()
    {
        _timerCts?.Cancel();
        _timer?.Dispose();
        _timerCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
