        }
        finally
        {
            isProcessingLeave = false;

            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (!_chartsDirty)
            return;

        if (trends.Count == 0 && summary is null)
            return;

        await DrawChartsAsync();
    }


    private async Task DrawChartsAsync()
    {
        if (_disposed)
            return;

        try
        {
            // DOM render хийгдсэний дараа chart зурна.
            if (trends.Count > 0)
            {
                await JS.InvokeVoidAsync(
                    "renderAttendanceChart",
                    "attendanceChart",
                    trends
                        .Select(t => t.Date.ToString("MM/dd"))
                        .ToArray(),
                    trends
                        .Select(t => t.Present)
                        .ToArray(),
                    trends
                        .Select(t => t.Late)
                        .ToArray(),
                    trends
                        .Select(t => t.Absent)
                        .ToArray(),
                    trends
                        .Select(t => t.OnLeave)
                        .ToArray()
                );
            }


            if (summary is not null)
            {
                await JS.InvokeVoidAsync(
                    "renderDonutChart",
                    "donutChart",
                    new[]
                    {
                        "Ирсэн",
                        "Хоцорсон",
                        "Чөлөөтэй",
                        "Ирээгүй"
                    },
                    new[]
                    {
                        summary.PresentToday,
                        summary.LateEmployees,
                        summary.OnLeaveEmployees,
                        summary.AbsentToday
                    },
                    new[]
                    {
                        "#16A34A",
                        "#D97706",
                        "#7C3AED",
                        "#DC2626"
                    }
                );
            }


            _chartDrawn = true;
            _chartsDirty = false;
        }
        catch (JSException)
        {
            // Canvas DOM бүрэн үүсээгүй бол
            // дараагийн render дээр дахин оролдоно.
            _chartDrawn = false;
            _chartsDirty = true;
        }
        catch (Exception ex)
        {
            _chartDrawn = false;
            _chartsDirty = true;
            error = ex.Message;
        }
    }


    private void OnAutoRefreshChanged()
    {
        StopAutoRefresh();

        if (!autoRefresh)
            return;

        _timerCts =
            new CancellationTokenSource();

        _timer =
            new PeriodicTimer(
                TimeSpan.FromSeconds(30)
            );

        _ = AutoRefreshLoopAsync(
            _timer,
            _timerCts.Token
        );
    }


    private async Task AutoRefreshLoopAsync(
        PeriodicTimer timer,
        CancellationToken token)
    {
        try
        {
            while (
                !_disposed &&
                await timer.WaitForNextTickAsync(token))
            {
                if (_disposed)
                    break;

                await InvokeAsync(
                    async () =>
                    {
                        await RefreshAsync();
                    }
                );
            }
        }
        catch (OperationCanceledException)
        {
            // Normal stop.
        }
        catch (ObjectDisposedException)
        {
            // Component disposed.
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    error = ex.Message;
                    StateHasChanged();
                });
            }
        }
    }


    private void StopAutoRefresh()
    {
        try
        {
            _timerCts?.Cancel();
        }
        catch
        {
            // Already disposed.
        }

        _timer?.Dispose();
        _timer = null;

        _timerCts?.Dispose();
        _timerCts = null;
    }


    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }

        _page = 1;
    }


    private string SortIndicator(string column) =>
        _sortColumn != column
            ? ""
            : (_sortDescending ? "▼" : "▲");


    private void OnFilterChanged()
    {
        _page = 1;
        EnsureValidPage();
    }


    private void OnSearchChanged(ChangeEventArgs e)
    {
        _tableSearch =
            e.Value?.ToString();

        _page = 1;

        EnsureValidPage();
    }


    private void PreviousPage()
    {
        if (_page > 1)
            _page--;

        EnsureValidPage();
    }


    private void NextPage()
    {
        if (_page < TotalPages)
            _page++;

        EnsureValidPage();
    }


    private void EnsureValidPage()
    {
        if (_page < 1)
            _page = 1;

        if (_page > TotalPages)
            _page = TotalPages;
    }


    private async Task ExportTodayCsv()
    {
        if (filtered.Count == 0)
            return;

        var lines =
            new List<string>
            {
                "Ажилтан,Ирсэн цаг,Явсан цаг,Ажилласан цаг,Илүү цаг,Төлөв"
            };


        foreach (var row in filtered)
        {
            var overtime =
                CalculateOvertime(row);

            lines.Add(
                string.Join(
                    ",",
                    Csv(row.EmployeeName),
                    Csv(row.CheckInTime?.ToString("HH:mm")),
                    Csv(row.CheckOutTime?.ToString("HH:mm")),
                    Csv(row.WorkHours.ToString("0.#")),
                    Csv(overtime.ToString("0.##")),
                    Csv(GetStatus(row))
                )
            );
        }


        // UTF-8 BOM нь Excel дээр Монгол хэл
        // зөв харагдахад тусална.
        var csv =
            "\uFEFF" +
            string.Join(
                "\r\n",
                lines
            );


        await JS.InvokeVoidAsync(
            "downloadCsv",
            $"irts_{Clock.TodayLocal:yyyy-MM-dd}.csv",
            csv
        );
    }


    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return "";

        return
            $"\"{value.Replace("\"", "\"\"")}\"";
    }


    private string GetWeekLabel()
    {
        var date = Clock.TodayLocal;
        var dayOfYear =
            date.DayOfYear;

        var week =
            (dayOfYear - 1) / 7 + 1;

        return $"Долоо хоног {week}";
    }


    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries
            );

        return string.Concat(
                parts
                    .Take(2)
                    .Select(x => x[0])
            )
            .ToUpperInvariant();
    }


    private static readonly string[] AvatarPalette =
    [
        "#2563EB",
        "#16A34A",
        "#D97706",
        "#7C3AED",
        "#DC2626",
        "#0891B2",
        "#DB2777"
    ];


    private static string AvatarColor(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return AvatarPalette[0];

        var hash =
            name.Sum(c => c);

        return
            AvatarPalette[
                Math.Abs(hash) %
                AvatarPalette.Length
            ];
    }


    private static string PercentValue(
        int? part,
        int? total)
    {
        if (
            part is null ||
            total is null ||
            total <= 0)
        {
            return "0";
        }

        var value =
            part.Value * 100m /
            total.Value;

        return
            Math.Round(
                value,
                1,
                MidpointRounding.AwayFromZero
            ).ToString("0.#");
    }


    private static string PercentLabel(
        int? part,
        int? total)
    {
        if (
            part is null ||
            total is null ||
            total <= 0)
        {
            return "—";
        }

        return
            $"{PercentValue(part, total)}%";
    }


    private static string ClampPercent(
        decimal value)
    {
        return Math.Clamp(
            value,
            0,
            100
        ).ToString("0.#");
    }


