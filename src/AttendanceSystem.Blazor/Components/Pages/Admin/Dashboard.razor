    private static string GetStatus(
        AttendanceDto row)
    {
        var status =
            row.Status;

        if (!string.IsNullOrWhiteSpace(status))
            return NormalizeStatus(status);

        return NormalizeStatus(
            row.AttendanceStatus
        );
    }


    private static string NormalizeStatus(
        string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "";

        var value =
            status.Trim();

        return value.ToLowerInvariant() switch
        {
            "present" => "Present",
            "0" => "Present",

            "late" => "Late",
            "1" => "Late",

            "earlyleave" => "EarlyLeave",
            "early_leave" => "EarlyLeave",
            "2" => "EarlyLeave",

            "absent" => "Absent",
            "3" => "Absent",

            "onleave" => "OnLeave",
            "on_leave" => "OnLeave",
            "4" => "OnLeave",

            "holiday" => "Holiday",
            "5" => "Holiday",

            "nightshift" => "NightShift",
            "night_shift" => "NightShift",
            "6" => "NightShift",

            "weekendwork" => "WeekendWork",
            "weekend_work" => "WeekendWork",
            "7" => "WeekendWork",

            "halfday" => "HalfDay",
            "half_day" => "HalfDay",
            "8" => "HalfDay",

            "pendingmanualreview" =>
                "PendingManualReview",

            "pending_manual_review" =>
                "PendingManualReview",

            "9" =>
                "PendingManualReview",

            _ => value
        };
    }


    private static decimal CalculateOvertime(AttendanceDto row)
{
    // Backend дээр overtime аль хэдийн бодогдсон бол
    // тэр утгыг шууд ашиглана.
    if (row.OvertimeHours > 0)
        return row.OvertimeHours;

    if (!row.CheckInTime.HasValue ||
        !row.CheckOutTime.HasValue)
    {
        return 0m;
    }

    var workedHours =
        (decimal)(
            row.CheckOutTime.Value -
            row.CheckInTime.Value
        ).TotalHours;

    if (workedHours <= StandardWorkingHours)
        return 0m;

    return workedHours - StandardWorkingHours;
}


