    private async Task QuickApproveAsync(Guid id)
    {
        if (isProcessingLeave || _disposed)
            return;

        try
        {
            isProcessingLeave = true;
            error = null;

            await Api.ApproveLeaveRequestAsync(id);

            // Leave-ийн хүсэлтээс гадна KPI,
            // ирцийн summary ч өөрчлөгдөж болох тул
            // dashboard-ийг бүхэлд нь refresh хийнэ.
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            error = GetFriendlyErrorMessage(ex);
        }
        finally
        {
            isProcessingLeave = false;

            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }


