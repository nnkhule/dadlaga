    {
        "Annual" => "Жилийн ээлжийн",
        "Sick" => "Өвчтэй",
        "Unpaid" => "Цалингүй",
        "Birthday" => "Төрсөн өдөр",
        "Maternity" => "Жирэмсний",
        "Other" => "Бусад",
