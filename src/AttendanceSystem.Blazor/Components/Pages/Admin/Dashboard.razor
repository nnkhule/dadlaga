@page "/admin/dashboard"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.SuperAdmin + "," + AppRoles.HrManager + "," + AppRoles.DepartmentHead)]
@implements IAsyncDisposable

@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AttendanceSystem.Application.Common.IClock Clock

<PageHeader Title="Хянах самбар"
            Subtitle="@($"{Clock.TodayLocal:yyyy оны MM сарын dd} • {GetWeekLabel()}")"
            Icon="▦" />

<div class="page-stack">

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            ⚠ @error
        </div>
    }

    <!-- KPI Cards -->
    <div class="kpi-grid">

        <!-- Нийт ажилтан -->
        <div class="kpi-card kpi-blue">
            <div class="kpi-top">
                <div class="kpi-icon">👥</div>
                <div class="kpi-trend neutral">Нийт</div>
            </div>

            <div class="kpi-value">
                @(summary?.ActiveEmployees ?? 0)
            </div>

            <div class="kpi-label">
                Нийт ажилтан
            </div>

            <div class="kpi-bar">
                <div class="kpi-bar-fill" style="width:100%"></div>
            </div>
        </div>

        <!-- Ирсэн -->
        <div class="kpi-card kpi-green">
            <div class="kpi-top">
                <div class="kpi-icon">✓</div>

                <div class="kpi-trend up">
                    ↑ @PercentLabel(summary?.PresentToday, summary?.ActiveEmployees)
                </div>
            </div>

            <div class="kpi-value">
                @(summary?.PresentToday ?? 0)
            </div>

            <div class="kpi-label">
                Өнөөдөр ирсэн
            </div>

            <div class="kpi-sub">
                @PercentLabel(summary?.PresentToday, summary?.ActiveEmployees)
            </div>

            <div class="kpi-bar">
                <div class="kpi-bar-fill"
                     style="width:@PercentValue(summary?.PresentToday, summary?.ActiveEmployees)%">
                </div>
            </div>
        </div>

        <!-- Ирээгүй -->
        <div class="kpi-card kpi-red">
            <div class="kpi-top">
                <div class="kpi-icon">✗</div>

                <div class="kpi-trend down">
                    Анхаар
                </div>
            </div>

            <div class="kpi-value">
                @(summary?.AbsentToday ?? 0)
            </div>

            <div class="kpi-label">
                Ирээгүй / тооцоогүй
            </div>

            <div class="kpi-bar">
                <div class="kpi-bar-fill"
                     style="width:@PercentValue(summary?.AbsentToday, summary?.ActiveEmployees)%">
                </div>
            </div>
        </div>

        <!-- Хоцорсон -->
        <div class="kpi-card kpi-yellow">
            <div class="kpi-top">
                <div class="kpi-icon">!</div>

                <div class="kpi-trend down">
                    Хожуу
                </div>
            </div>

            <div class="kpi-value">
                @(summary?.LateEmployees ?? 0)
            </div>

            <div class="kpi-label">
                Хоцорсон
            </div>

            <div class="kpi-bar">
                <div class="kpi-bar-fill"
                     style="width:@PercentValue(summary?.LateEmployees, summary?.ActiveEmployees)%">
                </div>
            </div>
        </div>

        <!-- Чөлөө -->
        <div class="kpi-card kpi-purple">
            <div class="kpi-top">
                <div class="kpi-icon">□</div>

                <div class="kpi-trend neutral">
                    @(summary?.OnLeaveEmployees ?? 0) хүн
                </div>
            </div>

            <div class="kpi-value">
                @(summary?.OnLeaveEmployees ?? 0)
            </div>

            <div class="kpi-label">
                Чөлөөтэй
            </div>

            <div class="kpi-bar">
                <div class="kpi-bar-fill"
                     style="width:@PercentValue(summary?.OnLeaveEmployees, summary?.ActiveEmployees)%">
                </div>
            </div>
        </div>

        <!-- Ирцийн хувь -->
        <div class="kpi-card kpi-orange">
            <div class="kpi-top">
                <div class="kpi-icon">⏱</div>

                <div class="kpi-trend up">
                    @(summary?.TotalOvertimeHours ?? 0)ц илүү
                </div>
            </div>

            <div class="kpi-value">
                @($"{summary?.AttendanceRate ?? 0:0.#}%")
            </div>

            <div class="kpi-label">
                Ирцийн хувь
            </div>

            <div class="kpi-bar">
                <div class="kpi-bar-fill"
                     style="width:@ClampPercent(summary?.AttendanceRate ?? 0)%">
                </div>
            </div>
        </div>

    </div>


    <!-- Charts -->
    <div class="dash-grid">

        <!-- Donut -->
        <div class="card">

            <div class="section-header">
                <h2>Өнөөдрийн ирцийн хуваарилалт</h2>

                <span class="muted">
                    @Clock.TodayLocal.ToString("MM/dd")
                </span>
            </div>

            <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap">

                <div style="position:relative;width:160px;height:160px;flex-shrink:0">
                    <canvas id="donutChart"
                            width="160"
                            height="160"
                            style="width:160px;height:160px">
                    </canvas>
                </div>

                <div style="flex:1;min-width:160px;display:flex;flex-direction:column;gap:12px">

                    @foreach (var item in AttendanceLegend)
                    {
                        var value = GetLegendValue(item.Key);
                        var pct = PercentValue(value, summary?.ActiveEmployees);

                        <div>

                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">

                                <div style="display:flex;align-items:center;gap:6px;font-size:13px;font-weight:500">

                                    <span style="
                                        width:8px;
                                        height:8px;
                                        border-radius:50%;
                                        background:@item.Color;
                                        flex-shrink:0">
                                    </span>

                                    @item.Label

                                </div>

                                <span style="font-size:13px;font-weight:700">
                                    @value
                                    <span class="muted" style="font-weight:400">
                                        (@pct%)
                                    </span>
                                </span>

                            </div>

                            <div style="
                                height:5px;
                                background:var(--clr-border);
                                border-radius:var(--radius-full);
                                overflow:hidden">

                                <div style="
                                    height:100%;
                                    width:@pct%;
                                    background:@item.Color;
                                    border-radius:var(--radius-full);
                                    transition:width .6s ease">
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- Bottom stats -->
            <div class="avg-stat-row" style="margin-top:20px">

                <div class="avg-stat-item">
                    <div class="avg-stat-value text-blue">
                        @(summary?.ActiveEmployees ?? 0)
                    </div>

                    <div class="avg-stat-label">
                        Нийт ажилтан
                    </div>
                </div>

                <div class="avg-stat-item">
                    <div class="avg-stat-value text-green">
                        @(summary?.PresentToday ?? 0)
                    </div>

                    <div class="avg-stat-label">
                        Ирсэн
                    </div>
                </div>

                <div class="avg-stat-item">
                    <div class="avg-stat-value text-orange">
                        @($"{summary?.AttendanceRate ?? 0:0.#}%")
                    </div>

                    <div class="avg-stat-label">
                        Ирцийн хувь
                    </div>
                </div>

            </div>

        </div>


        <!-- Attendance trend -->
        <div class="card">

            <div class="section-header">

                <h2>
                    Ирцийн хандлага
                </h2>

                <span class="muted">
                    Сүүлийн @trends.Count өдөр
                </span>

            </div>

            <div style="position:relative;height:240px">

                <canvas id="attendanceChart"></canvas>

            </div>

        </div>

    </div>


    <!-- Departments + Leave + Activity -->
    <div class="dash-grid-3"
         style="
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
            gap:16px">

        <!-- Departments -->
        <div class="card">

            <div class="section-header">

                <h2>
                    Хэлтэсүүд
                </h2>

                <a href="/admin/departments"
                   style="font-size:12px">
                    Бүгдийг харах →
                </a>

            </div>

            @if (departments.Count == 0)
            {
                <div class="muted"
                     style="padding:1rem;text-align:center">
                    Хэлтэс олдсонгүй.
                </div>
            }
            else
            {
                var maxCount = Math.Max(
                    1,
                    departments.Max(d => d.EmployeeCount)
                );

                <div style="display:flex;flex-direction:column;gap:10px">

                    @foreach (var dept in departments
                        .OrderByDescending(d => d.EmployeeCount)
                        .Take(6))
                    {
                        var widthPct =
                            (int)Math.Round(
                                dept.EmployeeCount * 100.0 / maxCount
                            );

                        <div>

                            <div style="
                                display:flex;
                                justify-content:space-between;
                                font-size:13px;
                                margin-bottom:2px">

                                <span style="font-weight:600">
                                    @dept.Name
                                </span>

                                <span class="muted">
                                    @dept.EmployeeCount хүн
                                </span>

                            </div>

                            <div style="
                                width:100%;
                                height:6px;
                                background:var(--clr-border);
                                border-radius:20px;
                                overflow:hidden">

                                <div style="
                                    height:100%;
                                    width:@widthPct%;
                                    background:#2563EB;
                                    border-radius:20px">
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>


        <!-- Pending leaves -->
        <div class="card">

            <div class="section-header">

                <h2>
                    Хүлээгдэж буй чөлөө
                </h2>

                <a href="/admin/leave"
                   style="font-size:12px">
                    Бүгдийг харах →
                </a>

            </div>

            @if (isLoadingLeave)
            {
                <div class="muted"
                     style="padding:1rem;text-align:center">
                    Ачааллаж байна...
                </div>
            }
            else if (pendingLeaves.Count == 0)
            {
                <div class="muted"
                     style="padding:1rem;text-align:center">
                    Хүлээгдэж буй хүсэлт алга 🎉
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:10px">

                    @foreach (var leave in pendingLeaves)
                    {
                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                            gap:8px;
                            padding:8px 0;
                            border-bottom:1px solid var(--clr-border)">

                            <div style="min-width:0">

                                <div style="
                                    font-weight:600;
                                    font-size:13px;
                                    white-space:nowrap;
                                    overflow:hidden;
                                    text-overflow:ellipsis">

                                    @(leave.EmployeeName ?? "—")

                                </div>

                                <div class="muted"
                                     style="font-size:12px">

                                    @TranslateLeaveType(leave.LeaveType)
                                    •
                                    @leave.StartDate.ToString("MM/dd")

                                    @if (leave.EndDate != leave.StartDate)
                                    {
                                        <text>
                                            - @leave.EndDate.ToString("MM/dd")
                                        </text>
                                    }

                                </div>

                            </div>

                            <div style="
                                display:flex;
                                gap:4px;
                                flex-shrink:0">

                                <button class="btn btn-success btn-sm"
                                        title="Зөвшөөрөх"
                                        disabled="@isProcessingLeave"
                                        @onclick="() => QuickApproveAsync(leave.Id)">
                                    ✓
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        title="Татгалзах"
                                        disabled="@isProcessingLeave"
                                        @onclick="() => QuickRejectAsync(leave.Id)">
                                    ✗
                                </button>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>


        <!-- Activities -->
        <div class="card">

            <div class="section-header">
                <h2>
                    Сонин мэдээ
                </h2>
            </div>

            @if (activities.Count == 0)
            {
                <div class="muted"
                     style="padding:1rem;text-align:center">
                    Сонин мэдээ алга.
                </div>
            }
            else
            {
                <div style="
                    display:flex;
                    flex-direction:column;
                    gap:10px;
                    max-height:280px;
                    overflow-y:auto">

                    @foreach (var activity in activities)
                    {
                        var activityColor = ActivityColor(activity.Type);

                        <div style="
                            display:flex;
                            gap:10px;
                            align-items:flex-start">

                            <div style="
                                width:28px;
                                height:28px;
                                border-radius:50%;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                flex-shrink:0;
                                background:@($"{activityColor}1A");
                                color:@activityColor;
                                font-size:13px">

                                @ActivityIcon(activity.Type)

                            </div>

                            <div style="min-width:0">

                                <div style="
                                    font-size:13px;
                                    font-weight:600">
                                    @activity.Title
                                </div>

                                <div class="muted"
                                     style="font-size:12px">
                                    @activity.Message
                                </div>

                                <div class="muted"
                                     style="font-size:11px">
                                    @RelativeTime(activity.CreatedDate)
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>


    <!-- Today's attendance -->
    <div class="card">

        <div class="section-header">

            <h2>
                Өнөөдрийн ирц
            </h2>

            <div style="
                display:flex;
                align-items:center;
                gap:10px;
                flex-wrap:wrap">

                <span style="
                    font-size:12px;
                    color:var(--clr-text-muted)">

                    @filtered.Count / @records.Count бүртгэл

                </span>

                <select class="form-control"
                        style="width:140px;height:34px;font-size:13px"
                        @bind="_statusFilter"
                        @bind:after="OnFilterChanged">

                    <option value="">
                        Бүх төлөв
                    </option>

                    <option value="Present">
                        Ирсэн
                    </option>

                    <option value="Late">
                        Хоцорсон
                    </option>

                    <option value="EarlyLeave">
                        Эрт явсан
                    </option>

                    <option value="Absent">
                        Ирээгүй
                    </option>

                    <option value="OnLeave">
                        Чөлөөтэй
                    </option>

                    <option value="HalfDay">
                        Хагас өдөр
                    </option>

                    <option value="NightShift">
                        Шөнийн ээлж
                    </option>

                    <option value="WeekendWork">
                        Амралтын өдөр
                    </option>

                    <option value="PendingManualReview">
                        Хяналт хүлээгдэж буй
                    </option>

                </select>

                <input class="form-control"
                       style="width:200px;height:34px;font-size:13px"
                       placeholder="Хайх..."
                       value="@_tableSearch"
                       @oninput="OnSearchChanged" />

            </div>

        </div>


        <div class="table-responsive">

            <table class="data-table">

                <thead>

                    <tr>

                        <th style="cursor:pointer"
                            @onclick='() => SetSort("name")'>

                            Ажилтан
                            @SortIndicator("name")

                        </th>

                        <th style="cursor:pointer"
                            @onclick='() => SetSort("checkin")'>

                            Ирсэн цаг
                            @SortIndicator("checkin")

                        </th>

                        <th>
                            Явсан цаг
                        </th>

                        <th style="cursor:pointer"
                            @onclick='() => SetSort("hours")'>

                            Ажилласан
                            @SortIndicator("hours")

                        </th>

                        <th>
                            Илүү цаг
                        </th>

                        <th>
                            Төлөв
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!pagedRows.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="muted"
                                style="
                                    text-align:center;
                                    padding:24px">

                                Өнөөдрийн бүртгэл олдсонгүй.

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var row in pagedRows)
                        {
                            var overtime = CalculateOvertime(row);

                            <tr>

                                <td>

                                    <div style="
                                        display:flex;
                                        align-items:center;
                                        gap:8px">

                                        <div class="emp-row-avatar"
                                             style="
                                                background:@AvatarColor(row.EmployeeName)">

                                            @Initials(row.EmployeeName)

                                        </div>

                                        <span style="font-weight:600">
                                            @(row.EmployeeName ?? "—")
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    @(row.CheckInTime?.ToString("HH:mm") ?? "—")
                                </td>

                                <td>
                                    @(row.CheckOutTime?.ToString("HH:mm") ?? "—")
                                </td>

                                <td>
                                    @(row.WorkHours > 0
                                        ? $"{row.WorkHours:0.#}ц"
                                        : "—")
                                </td>

                                <td>
                                    @(overtime > 0
                                        ? $"{overtime:0.##}ц"
                                        : "—")
                                </td>

                                <td>
                                    <StatusBadge Status="@GetStatus(row)" />
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        @if (filtered.Count > PageSize)
        {
            <div style="
                display:flex;
                justify-content:center;
                align-items:center;
                gap:10px;
                margin-top:10px">

                <button class="btn btn-ghost btn-sm"
                        disabled="@(_page <= 1)"
                        @onclick="PreviousPage">

                    ‹ Өмнөх

                </button>

                <span class="muted"
                      style="font-size:13px">

                    Хуудас @_page / @TotalPages

                </span>

                <button class="btn btn-ghost btn-sm"
                        disabled="@(_page >= TotalPages)"
                        @onclick="NextPage">

                    Дараах ›

                </button>

            </div>
        }

    </div>

</div>


@code {

    private const int PageSize = 10;

    // 09:00 - 18:00 schedule = 8 working hours.
    // Хэрэв backend дээр өөр schedule ашигладаг бол
    // энд hardcode хийхийн оронд backend-ийн OvertimeHours-г ашиглах нь зөв.
    private const decimal StandardWorkingHours = 8.0m;

    private DashboardSummaryDto? summary;

    private IReadOnlyList<AttendanceDto> records = [];

    private IReadOnlyList<AttendanceTrendDto> trends = [];

    private IReadOnlyList<DepartmentDto> departments = [];

    private IReadOnlyList<LeaveDto> pendingLeaves = [];

    private IReadOnlyList<RecentActivityDto> activities = [];

    private string? error;

    private string? _tableSearch;

    private string _statusFilter = "";

    private string _sortColumn = "name";

    private bool _sortDescending;

    private int _page = 1;

    private bool _chartDrawn;

    private bool _chartsDirty = true;

    private bool isLoading;

    private bool isLoadingLeave;

    private bool isProcessingLeave;

    private bool _refreshInProgress;

    private bool autoRefresh;

    private bool _disposed;

    private DateTime _lastUpdated;

    private PeriodicTimer? _timer;

    private CancellationTokenSource? _timerCts;


    private sealed record LegendItem(
        string Key,
        string Label,
        string Color
    );


    private static readonly LegendItem[] AttendanceLegend =
    [
        new("Present", "Ирсэн", "#16A34A"),
        new("Late", "Хоцорсон", "#D97706"),
        new("OnLeave", "Чөлөөтэй", "#7C3AED"),
        new("Absent", "Ирээгүй", "#DC2626")
    ];


    private IReadOnlyList<AttendanceDto> filtered =>
        records
            .Where(r =>
                string.IsNullOrWhiteSpace(_tableSearch) ||
                (r.EmployeeName ?? "")
                    .Contains(
                        _tableSearch,
                        StringComparison.OrdinalIgnoreCase
                    ))
            .Where(r =>
                string.IsNullOrWhiteSpace(_statusFilter) ||
                string.Equals(
                    GetStatus(r),
                    _statusFilter,
                    StringComparison.OrdinalIgnoreCase
                ))
            .ToList();


    private IReadOnlyList<AttendanceDto> sorted =>
        _sortColumn switch
        {
            "checkin" =>
                _sortDescending
                    ? filtered
                        .OrderByDescending(r => r.CheckInTime)
                        .ToList()
                    : filtered
                        .OrderBy(r => r.CheckInTime)
                        .ToList(),

            "hours" =>
                _sortDescending
                    ? filtered
                        .OrderByDescending(r => r.WorkHours)
                        .ToList()
                    : filtered
                        .OrderBy(r => r.WorkHours)
                        .ToList(),

            _ =>
                _sortDescending
                    ? filtered
                        .OrderByDescending(r => r.EmployeeName)
                        .ToList()
                    : filtered
                        .OrderBy(r => r.EmployeeName)
                        .ToList()
        };


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                filtered.Count / (double)PageSize
            )
        );


    private IReadOnlyList<AttendanceDto> pagedRows =>
        sorted
            .Skip(
                (Math.Min(_page, TotalPages) - 1)
                * PageSize
            )
            .Take(PageSize)
            .ToList();


    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }


    private async Task RefreshAsync()
    {
        if (_refreshInProgress || _disposed)
            return;

        _refreshInProgress = true;
        isLoading = true;
        error = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var today = Clock.TodayLocal.ToString("yyyy-MM-dd");

            var summaryTask =
                Api.GetDashboardSummaryAsync();

            var trendsTask =
                Api.GetAttendanceTrendsAsync();

            var recordsTask =
                Api.GetAsync<PagedResponse<AttendanceDto>>(
                    $"api/attendance/records?from={today}&to={today}&pageSize=100"
                );

            var departmentsTask =
                Api.GetAsync<PagedResponse<DepartmentDto>>(
                    "api/departments?pageNumber=1&pageSize=1000"
                );

            var leavesTask =
                LoadPendingLeavesAsync();

            var activitiesTask =
                LoadActivitiesAsync();


            await Task.WhenAll(
                summaryTask,
                trendsTask,
                recordsTask,
                departmentsTask,
                leavesTask,
                activitiesTask
            );


            summary =
                await summaryTask;

            trends =
                await trendsTask ?? [];

            var recordsResult =
                await recordsTask;

            records =
                recordsResult?.Items ?? [];

            var departmentsResult =
                await departmentsTask;

            departments =
                departmentsResult?.Items ?? [];


            _lastUpdated = Clock.LocalNow;

            EnsureValidPage();

            // IMPORTANT:
            // Chart drawing-г энд хийхгүй.
            // Blazor render дууссаны дараа OnAfterRenderAsync дотор хийнэ.
            _chartsDirty = true;
            _chartDrawn = false;
        }
        catch (Exception ex)
        {
            error = GetFriendlyErrorMessage(ex);
        }
        finally
        {
            _refreshInProgress = false;
            isLoading = false;

            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
