    private string RelativeTime(
        DateTime value)
    {
        var diff = Clock.LocalNow - value;

        if (diff.TotalDays >= 1)
            return $"{(int)diff.TotalDays} өдрийн өмнө";

        if (diff.TotalHours >= 1)
            return $"{(int)diff.TotalHours} цагийн өмнө";

        if (diff.TotalMinutes >= 1)
            return $"{(int)diff.TotalMinutes} минутын өмнө";

        return "дөнгөж сая";
    }


    private static string GetFriendlyErrorMessage(
        Exception ex)
    {
        if (ex is HttpRequestException)
        {
            return "API сервертэй холбогдож чадсангүй.";
        }

        if (ex is TaskCanceledException)
        {
            return "Хүсэлт хугацаа хэтэрсэн.";
        }

        return ex.Message;
    }


    public ValueTask DisposeAsync()
