@page "/admin/leave"
@layout AdminLayout
@attribute [Authorize(Roles = AppRoles.SuperAdmin + "," + AppRoles.HrManager + "," + AppRoles.DepartmentHead)]
@inject ApiClient Api

<PageHeader Title="Чөлөөний хүсэлтүүд" Subtitle="SQL Server-ээс ачааллагдсан чөлөөний хүсэлтүүд" Icon="☑" />

<div class="page-stack">
    <div class="tabs">
        @foreach (var tab in tabs)
        {
            <button class="tab @(activeStatus == tab.Key ? "active" : "")"
                    @onclick="() => ChangeTab(tab.Key)">@tab.Value</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="card" style="border-color:var(--clr-danger);color:var(--clr-danger)">@error</div>
    }

    @if (isLoading)
    {
        <div class="card muted">Ачааллаж байна...</div>
    }
    else if (requests.Count == 0)
    {
        <div class="card muted">Чөлөөний хүсэлт олдсонгүй.</div>
    }
    else
    {
        @foreach (var request in requests)
        {
            <div class="card">
                <div class="section-title">
                    <div>
                        <div class="muted" style="font-weight:600;font-size:0.95rem;color:var(--clr-text)">
                            👤 @Display(request.EmployeeName)
                        </div>
                        <strong>@TranslateLeaveType(request.LeaveType)</strong>
                        <span class="badge badge-leave">@TranslateLeaveType(request.LeaveType)</span>
                        <div class="muted">
                            @request.StartDate.ToString("yyyy-MM-dd")
                            -
                            @request.EndDate.ToString("yyyy-MM-dd")

                            @if (request.LeaveMode == "Hourly")
                            {
                                <span> • @(request.Hours ?? 0) цаг</span>
                            }
                            else
                            {
                                <span>
                                    • @((request.EndDate.DayNumber - request.StartDate.DayNumber) + 1) өдөр
                                </span>
                            }
                        </div>
                        <div>@Display(request.Reason)</div>
                    </div>
                    <StatusBadge Status="@(request.Status ?? request.ApprovalStatus ?? string.Empty)" />
                </div>
                @if (string.Equals(request.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="action-row" style="justify-content:flex-end; gap: 8px;">
                        <button class="btn btn-danger" @onclick="() => RejectAsync(request.Id)" disabled="@isProcessing">
                            @(isProcessing ? "Боловсруулж байна..." : "Татгалзах")
                        </button>
                        <button class="btn btn-success" @onclick="() => ApproveAsync(request.Id)" disabled="@isProcessing">
                            @(isProcessing ? "Боловсруулж байна..." : "Зөвшөөрөх")
                        </button>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    // Key = API-д явуулах статус нэр, Value = дэлгэцэн дээр харагдах Монгол нэр
    private readonly Dictionary<string, string> tabs = new()
    {
        ["Pending"] = "Хүлээгдэж буй",
        ["Approved"] = "Зөвшөөрсөн",
        ["Rejected"] = "Татгалзсан"
    };

    private string activeStatus = "Pending";
    private IReadOnlyList<LeaveDto> requests = [];
    private string? error;
    private bool isProcessing;
    private bool isLoading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            error = null;
            var result = await Api.GetAsync<PagedResponse<LeaveDto>>($"api/leave/requests?status={activeStatus}&pageSize=100");
            requests = result?.Items ?? [];
        }
        catch (Exception ex)
        {
            error = ex.Message;
            requests = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeTab(string status)
    {
        activeStatus = status;
        await LoadAsync();
    }

    private async Task ApproveAsync(Guid id)
    {
        if (isProcessing) return;

        try
        {
            error = null;
            isProcessing = true;
            StateHasChanged();

            var response = await Api.ApproveLeaveRequestAsync(id);
            if (!response.IsSuccessStatusCode)
            {
                error = $"Зөвшөөрөхөд алдаа гарлаа ({(int)response.StatusCode}).";
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RejectAsync(Guid id)
    {
        if (isProcessing) return;

        try
        {
            error = null;
            isProcessing = true;
            StateHasChanged();

            var response = await Api.RejectLeaveRequestAsync(id);
            if (!response.IsSuccessStatusCode)
            {
                error = $"Татгалзахад алдаа гарлаа ({(int)response.StatusCode}).";
                return;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string TranslateLeaveType(string type) => type switch
    {
        "Annual" => "Жилийн ээлжийн",
        "Sick" => "Өвчтэй",
        "Unpaid" => "Цалингүй",
        "Birthday" => "Төрсөн өдөр",
        "Maternity" => "Жирэмсний",
        "Other" => "Бусад",
        _ => type
    };
}
