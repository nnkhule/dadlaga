@page
@model AttendanceSystem.AdminPanel.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="mn">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Dashboard — Attendance Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: #0f172a; }
        .card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="min-h-screen text-white">

<!-- Sidebar -->
<div class="flex h-screen">
    <aside class="w-64 bg-slate-900 border-r border-slate-700 flex flex-col">
        <div class="p-6 border-b border-slate-700">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-bold text-white text-sm">Attendance</h1>
                    <p class="text-slate-400 text-xs">Admin Panel</p>
                </div>
            </div>
        </div>

        <nav class="flex-1 p-4 space-y-1">
            <a href="/Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-blue-600 text-white text-sm font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Dashboard
            </a>
            <a href="/Employees" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Ажилтнууд
            </a>
            <a href="/Attendance" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                Ирц
            </a>
            <a href="/Leave" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Чөлөө / Амралт
            </a>
            <a href="/Departments" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                Хэлтэс
            </a>
            <a href="/Reports" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Тайлан
            </a>
            <a href="/Settings" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Тохиргоо
            </a>
        </nav>

        <div class="p-4 border-t border-slate-700">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-xs font-bold">
                    @(Model.AdminEmail.Length > 0 ? Model.AdminEmail[0].ToString().ToUpper() : "A")
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">@Model.AdminEmail</p>
                    <p class="text-xs text-slate-400">Administrator</p>
                </div>
            </div>
            <form method="post" asp-page-handler="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg text-slate-300 hover:bg-red-900/40 hover:text-red-300 text-sm transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Гарах
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-auto">
        <!-- Top bar -->
        <div class="bg-slate-900 border-b border-slate-700 px-8 py-4 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold text-white">Dashboard</h2>
                <p class="text-slate-400 text-sm">@DateTime.Now.ToString("yyyy оны MM сарын dd")</p>
            </div>
            <div class="flex items-center gap-2 bg-green-900/30 border border-green-700/50 rounded-lg px-3 py-2">
                <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div>
                <span class="text-green-300 text-sm font-medium">Системд нэвтэрсэн</span>
            </div>
        </div>

        <div class="p-8">

            @if (!string.IsNullOrEmpty(Model.ApiError))
            {
                <div class="bg-red-900/30 border border-red-700/50 rounded-xl p-4 mb-6 text-red-300">
                    <strong>⚠ API алдаа:</strong> @Model.ApiError
                </div>
            }

            <!-- Stats Cards -->
            @if (Model.Summary is not null)
            {
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                    <div class="card rounded-xl p-5">
                        <p class="text-slate-400 text-xs font-medium uppercase tracking-wider mb-2">Нийт ажилтан</p>
                        <p class="text-3xl font-bold text-white">@Model.Summary.TotalEmployees</p>
                        <p class="text-slate-400 text-xs mt-1">Идэвхтэй: @Model.Summary.ActiveEmployees</p>
                    </div>
                    <div class="card rounded-xl p-5">
                        <p class="text-slate-400 text-xs font-medium uppercase tracking-wider mb-2">Өнөөдөр ирсэн</p>
                        <p class="text-3xl font-bold text-green-400">@Model.Summary.PresentToday</p>
                        <p class="text-slate-400 text-xs mt-1">Хувь: @Model.Summary.AttendanceRate%</p>
                    </div>
                    <div class="card rounded-xl p-5">
                        <p class="text-slate-400 text-xs font-medium uppercase tracking-wider mb-2">Ирээгүй</p>
                        <p class="text-3xl font-bold text-red-400">@Model.Summary.AbsentToday</p>
                        <p class="text-slate-400 text-xs mt-1">Хоцорсон: @Model.Summary.LateEmployees</p>
                    </div>
                    <div class="card rounded-xl p-5">
                        <p class="text-slate-400 text-xs font-medium uppercase tracking-wider mb-2">Чөлөөтэй</p>
                        <p class="text-3xl font-bold text-yellow-400">@Model.Summary.OnLeaveEmployees</p>
                        <p class="text-slate-400 text-xs mt-1">Илүү цаг: @Model.Summary.OvertimeHours.ToString("F1")ц</p>
                    </div>
                </div>
            }
            else if (string.IsNullOrEmpty(Model.ApiError))
            {
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="card rounded-xl p-5 animate-pulse">
                            <div class="h-3 bg-slate-700 rounded w-24 mb-3"></div>
                            <div class="h-8 bg-slate-700 rounded w-16 mb-2"></div>
                            <div class="h-3 bg-slate-700 rounded w-20"></div>
                        </div>
                    }
                </div>
            }

            <!-- Recent Activities -->
            <div class="card rounded-xl p-6">
                <h3 class="text-white font-semibold mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Сүүлийн үйл ажиллагаа
                </h3>
                @if (Model.RecentActivities.Count > 0)
                {
                    <div class="space-y-3">
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <div class="flex items-center gap-4 py-3 border-b border-slate-700/50 last:border-0">
                                <div class="w-8 h-8 rounded-full bg-blue-600/30 flex items-center justify-center text-xs font-bold text-blue-300">
                                    @(activity.EmployeeName.Length > 0 ? activity.EmployeeName[0].ToString() : "?")
                                </div>
                                <div class="flex-1">
                                    <p class="text-white text-sm font-medium">@activity.EmployeeName</p>
                                    <p class="text-slate-400 text-xs">@activity.Action @(activity.Department is not null ? $"· {activity.Department}" : "")</p>
                                </div>
                                <p class="text-slate-500 text-xs">@activity.Timestamp.ToString("HH:mm")</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-slate-400 text-sm text-center py-8">Өнөөдөр үйл ажиллагаа байхгүй байна</p>
                }
            </div>

        </div>
    </main>
</div>

</body>
</html>
