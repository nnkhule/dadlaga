@page "/admin/employees"
@layout AdminLayout
@inject ApiClient Api
@inject NavigationManager Nav

<PageHeader Title="Employees" Subtitle="Employee records loaded from the database" Icon="☷">
    <Actions><button class="btn-primary" @onclick="CreateEmployee">Add</button></Actions>
</PageHeader>

<div class="page-stack">
    <div class="card filter-bar">
        <input class="form-control" placeholder="Search employees" @bind="search" @bind:event="oninput" />
        <button class="btn btn-ghost" @onclick="LoadAsync">Search</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="card" style="border-color:var(--clr-danger);color:var(--clr-danger)">@error</div>
    }

    <div class="card">
        @if (employees.Count == 0)
        {
            <div class="empty-state">No employees found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Hire Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in employees)
                        {
                            <tr>
                                <td>@employee.EmployeeCode</td>
                                <td>@employee.FullName</td>
                                <td>@employee.Email</td>
                                <td>@Display(employee.Department ?? employee.DepartmentName)</td>
                                <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @(employee.IsActive ? "badge-present" : "badge-absent")">@Display(employee.Status ?? (employee.IsActive ? "Active" : "Inactive"))</span></td>
                                <td>
                                    <button class="btn btn-ghost" @onclick="() => ViewEmployee(employee.Id)">View</button>
                                    <button class="btn btn-primary" @onclick="() => EditEmployee(employee.Id)">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<EmployeeDto> employees = [];
    private string? search;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            error = null;
            var result = await Api.GetAsync<PagedResponse<EmployeeDto>>($"api/employees?pageNumber=1&pageSize=100&search={Uri.EscapeDataString(search ?? string.Empty)}");
            employees = result?.Items ?? [];
        }
        catch (Exception ex)
        {
            error = ex.Message;
            employees = [];
        }
    }

    private void CreateEmployee() => Nav.NavigateTo("/employees/create");

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "--" : value;

    private void EditEmployee(Guid id) => Nav.NavigateTo($"/employees/{id}/edit");
    private void ViewEmployee(Guid id) => Nav.NavigateTo($"/employees/{id}");
}
