@using AttendanceSystem.AdminPanel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model AttendanceSystem.AdminPanel.Pages.LoginModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="mn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — Attendance System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { font-family: 'Inter', system-ui, sans-serif; }
        body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%); }
        .glass { background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); }
        .glass-heavy { background: rgba(255,255,255,0.08); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.2); }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center px-4 py-8">

    <div class="w-full max-w-md relative z-10">

        <div class="text-center mb-10">
            <h1 class="text-4xl font-bold text-white mb-2">Admin Panel</h1>
            <p class="text-slate-300">Attendance Management System</p>
        </div>

        @if (Model.SessionExpired)
        {
            <div class="glass-heavy text-yellow-300 rounded-xl px-4 py-3 mb-4 border border-yellow-500/30">
                ⚠ Сессийн хугацаа дуусчээ. Дахин нэвтэрнэ үү.
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="glass-heavy text-red-300 rounded-xl px-4 py-3 mb-6 border border-red-500/30">
                <p class="font-semibold">Нэвтрэх амжилтгүй</p>
                <p class="text-sm opacity-90">@Model.ErrorMessage</p>
            </div>
        }

        <form method="post" class="glass-heavy rounded-2xl p-8 space-y-6">
            @Html.AntiForgeryToken()

            <div>
                <label for="Email" class="block text-sm font-semibold text-slate-200 mb-2">И-мэйл</label>
                <input asp-for="Input.Email" id="Email" type="email" autocomplete="username"
                       placeholder="admin@attendance.local"
                       class="w-full glass rounded-lg px-4 py-3 text-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                <span asp-validation-for="Input.Email" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div>
                <label for="Password" class="block text-sm font-semibold text-slate-200 mb-2">Нууц үг</label>
                <div class="relative">
                    <input asp-for="Input.Password" id="Password" type="password" autocomplete="current-password"
                           placeholder="••••••••"
                           class="w-full glass rounded-lg px-4 py-3 text-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition pr-12" />
                    <button type="button" onclick="togglePassword()"
                            class="absolute inset-y-0 right-3 text-slate-400 hover:text-slate-200 transition">
                        👁
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div class="flex items-center">
                <input asp-for="Input.RememberMe" id="RememberMe" type="checkbox"
                       class="w-4 h-4 rounded border-slate-500 bg-slate-700/50 text-blue-500 cursor-pointer" />
                <label for="RememberMe" class="ml-2 text-sm text-slate-300 cursor-pointer">Намайг санах</label>
            </div>

            <button type="submit" id="submit-btn"
                    class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800
                           text-white font-semibold rounded-lg py-3 text-sm transition
                           focus:outline-none focus:ring-2 focus:ring-blue-500
                           disabled:opacity-50 transform hover:scale-105 active:scale-95 shadow-lg">
                Нэвтрэх
            </button>
        </form>

        <p class="mt-6 text-center text-slate-500 text-xs">
            &copy; @DateTime.Now.Year Attendance System
        </p>

    </div>

    <script>
        function togglePassword() {
            var input = document.getElementById('Password');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
        document.querySelector('form').addEventListener('submit', function () {
            var btn = document.getElementById('submit-btn');
            btn.disabled = true;
            btn.textContent = 'Нэвтэрч байна...';
        });
    </script>

</body>
</html>
