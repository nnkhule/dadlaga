@page "/admin/ai-chat"
@layout AdminLayout
@using AttendanceSystem.Application.DTOs.AI
@inject ApiClient Api
@inject ILogger<AiChat> Logger
@inject IJSRuntime JS
@attribute [Authorize(Roles = AppRoles.SuperAdmin + "," + AppRoles.HrManager + "," + AppRoles.DepartmentHead)]

<PageHeader Title="AI Туслах" Subtitle="Систем дотроос асуулт асуу, шуурхай хариулт ав" />

<div class="page-stack">

<div class="ai-chat-container">
    <div class="ai-chat-messages" @ref="messagesContainer" id="adminChatMessages">
        @if (!messages.Any())
        {
            <div class="ai-chat-empty">
                <i class="bi bi-robot ai-chat-empty-icon"></i>
                <p>Сайн байна уу! Би танд ирц, ажилтан, амралтын мэдээлэлтэй холбоотой асуултад тусална.</p>
                <div class="ai-chat-suggestions">
                    <button class="suggestion-chip" @onclick='() => SendSuggestion("Өнөөдөр хэдэн ажилтан ирсэн бэ?")'>Өнөөдрийн ирц</button>
                    <button class="suggestion-chip" @onclick='() => SendSuggestion("Хүлээгдэж буй амралтын хүсэлт хэд байна?")'>Амралтын хүсэлт</button>
                    <button class="suggestion-chip" @onclick='() => SendSuggestion("Нийт хэдэн ажилтантай вэ?")'>Нийт ажилтан</button>
                </div>
            </div>
        }
        else
        {
            @foreach (var msg in messages)
            {
                <div class="ai-chat-bubble @(msg.Role == "user" ? "ai-chat-bubble-user" : "ai-chat-bubble-assistant")">
                    <div class="ai-chat-bubble-content">
                        @msg.Content
                    </div>
                    <div class="ai-chat-bubble-time">@msg.Timestamp.ToString("HH:mm")</div>
                </div>
            }
        }

        @if (isLoading)
        {
            <div class="ai-chat-bubble ai-chat-bubble-assistant">
                <div class="ai-chat-typing">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }
    </div>

    <div class="ai-chat-input-area">
        <input class="ai-chat-input"
               @bind="currentMessage"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               placeholder="Асуултаа бичээрэй..."
               disabled="@isLoading" />
        <button class="ai-chat-send-btn" @onclick="SendMessage" disabled="@(isLoading || string.IsNullOrWhiteSpace(currentMessage))">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
    </div>
</div>

@code {
    private List<ChatMessageItem> messages = new();
    private string currentMessage = string.Empty;
    private bool isLoading = false;
    private ElementReference messagesContainer;
    private const string StorageKey = "ai_admin_chat_history";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var json = await JS.InvokeAsync<string?>("chatHistoryStorage.load", StorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                try
                {
                    var saved = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessageItem>>(json);
                    if (saved != null && saved.Any())
                    {
                        messages = saved;
                        StateHasChanged();
                        await ScrollToBottom();
                    }
                }
                catch
                {
                    // хуучин/буруу формат бол үл тоомсорлоно
                }
            }
        }
    }

    private async Task SendSuggestion(string text)
    {
        currentMessage = text;
        await SendMessage();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isLoading)
            return;

        var userMessage = currentMessage.Trim();
        currentMessage = string.Empty;

        messages.Add(new ChatMessageItem
        {
            Role = "user",
            Content = userMessage,
            Timestamp = DateTime.Now
        });
        await SaveHistory();

        isLoading = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var historyPayload = messages
                .Where(m => m.Role == "user" || m.Role == "assistant")
                .Select(m => new ChatMessageDto { Role = m.Role, Content = m.Content })
                .ToList();

            var result = await Api.PostAdminChatAsync(new ChatRequestDto
            {
                Message = userMessage,
                History = historyPayload.Take(historyPayload.Count - 1).ToList()
            });
            messages.Add(new ChatMessageItem
            {
                Role = "assistant",
                Content = result?.Reply ?? "AI үйлчилгээнээс хариу ирсэнгүй. Дахин оролдоно уу.",
                Timestamp = DateTime.Now
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Admin AI chat request failed.");
            messages.Add(new ChatMessageItem
            {
                Role = "assistant",
                Content = ex is UnauthorizedAccessException
                    ? "Нэвтрэх эрхийн хугацаа дууссан байна. Дахин нэвтэрч оролдоно уу."
                    : "AI чат хүсэлт амжилтгүй боллоо. Сүлжээ болон AI үйлчилгээний тохиргоог шалгаад дахин оролдоно уу.",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
            await SaveHistory();
        }
    }

    private async Task SaveHistory()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(messages);
        await JS.InvokeVoidAsync("chatHistoryStorage.save", StorageKey, json);
    }

    private async Task ClearHistory()
    {
        messages.Clear();
        await JS.InvokeVoidAsync("chatHistoryStorage.clear", StorageKey);
    }

    private async Task ScrollToBottom()
    {
        await JS.InvokeVoidAsync("scrollElementToBottom", "adminChatMessages");
    }

    private class ChatMessageItem
    {
        public string Role { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
    }

}