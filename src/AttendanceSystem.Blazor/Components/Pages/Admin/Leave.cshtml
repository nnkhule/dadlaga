@page
@model AttendanceSystem.AdminPanel.Pages.LeaveModel
@{ ViewData["Title"] = "Чөлөө"; Layout = null; }
<!DOCTYPE html><html lang="mn"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Чөлөө — Attendance Admin</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>*{font-family:sans-serif;}body{background:#0f172a;}.card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);}</style>
</head><body class="min-h-screen text-white">
<div class="flex h-screen">
  <main class="flex-1 overflow-auto p-8">
    <div class="mb-6">
      <a href="/Dashboard" class="text-blue-400 hover:text-blue-300 text-sm mb-2 inline-block">← Dashboard</a>
      <h2 class="text-2xl font-bold">Чөлөө / Амралтын хүсэлт</h2>
    </div>
    @if (!string.IsNullOrEmpty(Model.ApiError))
    { <div class="bg-red-900/30 border border-red-700/50 rounded-xl p-4 mb-4 text-red-300">⚠ @Model.ApiError</div> }
    <div class="card rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-800/50">
          <tr>
            <th class="text-left px-4 py-3 text-slate-300">Ажилтан</th>
            <th class="text-left px-4 py-3 text-slate-300">Төрөл</th>
            <th class="text-left px-4 py-3 text-slate-300">Эхлэх</th>
            <th class="text-left px-4 py-3 text-slate-300">Дуусах</th>
            <th class="text-left px-4 py-3 text-slate-300">Төлөв</th>
            <th class="text-left px-4 py-3 text-slate-300">Үйлдэл</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/50">
          @foreach (var l in Model.Leaves)
          {
            <tr class="hover:bg-slate-800/30">
              <td class="px-4 py-3 text-white font-medium">@l.EmployeeName</td>
              <td class="px-4 py-3 text-slate-300">@l.LeaveType</td>
              <td class="px-4 py-3 text-slate-300">@l.StartDate</td>
              <td class="px-4 py-3 text-slate-300">@l.EndDate</td>
              <td class="px-4 py-3">
                @{
                  var sc = l.Status switch {
                    "Approved" => "bg-green-900/40 text-green-300",
                    "Pending"  => "bg-yellow-900/40 text-yellow-300",
                    "Rejected" => "bg-red-900/40 text-red-300",
                    _ => "bg-slate-700 text-slate-300"
                  };
                  var smn = l.Status switch { "Approved"=>"Зөвшөөрсөн","Pending"=>"Хүлээгдэж буй","Rejected"=>"Татгалзсан",_=>l.Status };
                }
                <span class="@sc px-2 py-0.5 rounded text-xs">@smn</span>
              </td>
              <td class="px-4 py-3">
                @if (l.Status == "Pending")
                {
                  <div class="flex gap-2">
                    <form method="post" asp-page-handler="Approve" asp-route-id="@l.Id">
                      @Html.AntiForgeryToken()
                      <button type="submit" class="bg-green-700 hover:bg-green-600 px-3 py-1 rounded text-xs text-white">✓ Зөвшөөрөх</button>
                    </form>
                    <form method="post" asp-page-handler="Reject" asp-route-id="@l.Id">
                      @Html.AntiForgeryToken()
                      <button type="submit" class="bg-red-700 hover:bg-red-600 px-3 py-1 rounded text-xs text-white">✕ Татгалзах</button>
                    </form>
                  </div>
                }
                else { <span class="text-slate-500 text-xs">—</span> }
              </td>
            </tr>
          }
          @if (Model.Leaves.Count == 0)
          { <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Чөлөөний хүсэлт байхгүй</td></tr> }
        </tbody>
      </table>
    </div>
  </main>
</div>
</body></html>
