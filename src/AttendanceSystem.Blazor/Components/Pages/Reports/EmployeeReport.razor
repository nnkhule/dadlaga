@page "/admin/reports/employee"
@page "/admin/reports/employee/{EmployeeId:guid}"

@layout AdminLayout
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS


<PageTitle>Ажилтны тайлан — AttendIQ</PageTitle>

@if (_showInitialSpinner)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Ачааллаж байна...</p>
    </div>
}
else
{
    <div class="report-container">
        <!-- ── Header Section ── -->
        <div class="report-header">
            <div class="report-header-top">
                <button class="btn-back" @onclick="GoBack">
                    <span>←</span> Буцах
                </button>
                <div class="report-header-title">
                    <h1>Ажилтны хувийн тайлан</h1>
                    @if (_employee is not null)
                    {
                        <p class="subtitle">@_employee.FullName</p>
                    }
                </div>
                @if (_employee is not null && _report is not null)
                {
                    <div class="report-header-actions">
                        <button class="btn btn-primary" @onclick="ExportPdf" disabled="@_exporting">
                            @if (_exporting)
                            {
                                <span class="spinner-small"></span>
                                <span>Үүсгэж байна...</span>
                            }
                            else
                            {
                                <span>📄</span>
                                <span>PDF татах</span>
                            }
                        </button>
                        <button class="btn btn-secondary" @onclick="ExportExcel" disabled="@_exportingExcel">
                            @if (_exportingExcel)
                            {
                                <span class="spinner-small spinner-dark"></span>
                                <span>Үүсгэж байна...</span>
                            }
                            else
                            {
                                <span>📊</span>
                                <span>Excel татах</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- ── Error Message ── -->
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <div class="alert alert-error">
                <span>⚠️</span>
                <span>@_loadError</span>
                <button class="alert-close" @onclick='() => _loadError = null'>✕</button>
            </div>
        }

        <!-- ── Controls Section ── -->
        <div class="controls-panel">
            <div class="control-row">
                <div class="control-group">
                    <label>Ажилтан</label>
                    <select @onchange="OnEmployeeChange" disabled="@_loadingEmployees">
                        <option value="">— Ажилтан сонгох —</option>
                        @foreach (var emp in _employees)
                        {
                            <option value="@emp.Id" selected="@(EmployeeId == emp.Id)">
                                @emp.FullName (@emp.EmployeeCode)
                            </option>
                        }
                    </select>
                </div>

                <div class="control-group">
                    <label>Эхлэх огноо</label>
                    <input type="date" @bind="_from" @bind:after="LoadReport" />
                </div>

                <div class="control-group">
                    <label>Дуусах огноо</label>
                    <input type="date" @bind="_to" @bind:after="LoadReport" />
                </div>
            </div>

            <div class="shortcuts">
                <label>Хурдан сонголт:</label>
                <button class="shortcut-btn @(_period == "month" ? "active" : "")" @onclick='async () => await SetPeriod("month")'>
                    Энэ сар
                </button>
                <button class="shortcut-btn @(_period == "3month" ? "active" : "")" @onclick='async () => await SetPeriod("3month")'>
                    3 сар
                </button>
                <button class="shortcut-btn @(_period == "6month" ? "active" : "")" @onclick='async () => await SetPeriod("6month")'>
                    6 сар
                </button>
                <button class="shortcut-btn @(_period == "year" ? "active" : "")" @onclick='async () => await SetPeriod("year")'>
                    Энэ жил
                </button>
            </div>
        </div>

        <!-- ── Empty State ── -->
        @if (EmployeeId == default)
        {
            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <p>Тайлан харахын тулд ажилтан сонгоно уу.</p>
            </div>
        }
        <!-- ── Loading State ── -->
        else if (_loading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Тайлан ачааллаж байна...</p>
            </div>
        }
        <!-- ── Report Content ── -->
        else if (_report is not null)
        {
            <!-- Summary Cards -->
            <div class="summary-cards">
                <div class="card card-stat">
                    <div class="stat-number">@(_report?.TotalWorkDays ?? 0)</div>
                    <div class="stat-label">Нийт ажлын өдөр</div>
                </div>
                <div class="card card-stat card-success">
                    <div class="stat-number">@(_report?.PresentDays ?? 0)</div>
                    <div class="stat-label">Ирсэн өдөр</div>
                    <div class="stat-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @(Math.Min(_report?.AttendanceRate ?? 0, 100))%"></div>
                        </div>
                        <span class="progress-text">@((_report?.AttendanceRate ?? 0).ToString("F0"))%</span>
                    </div>
                </div>
                <div class="card card-stat card-warning">
                    <div class="stat-number">@(_report?.LateDays ?? 0)</div>
                    <div class="stat-label">Хоцорсон өдөр</div>
                </div>
                <div class="card card-stat card-danger">
                    <div class="stat-number">@(_report?.AbsentDays ?? 0)</div>
                    <div class="stat-label">Тасалсан өдөр</div>
                </div>
                <div class="card card-stat card-info">
                    <div class="stat-number">@((_report?.OvertimeHours ?? 0.0).ToString("F1"))</div>
                    <div class="stat-label">Илүү цаг</div>
                    <div class="stat-sub">цаг</div>
                </div>
                <div class="card card-stat">
                    <div class="stat-number">@(_report?.LeaveDays ?? 0)</div>
                    <div class="stat-label">Чөлөө авсан</div>
                    <div class="stat-sub">@(_report?.LeaveBalance ?? 0) өдөр үлдсэн</div>
                </div>
            </div>

            <!-- Tabs -->
            <div class="tabs-container">
                <div class="tabs">
                    <button class="tab @(_activeTab == "attendance" ? "active" : "")" @onclick='() => _activeTab = "attendance"'>
                        📅 Ирцийн түүх
                    </button>
                    <button class="tab @(_activeTab == "overtime" ? "active" : "")" @onclick='() => _activeTab = "overtime"'>
                        ⏱️ Цагийн тооцоо
                    </button>
                    <button class="tab @(_activeTab == "leave" ? "active" : "")" @onclick='() => _activeTab = "leave"'>
                        ✓ Чөлөө
                    </button>
                    <button class="tab @(_activeTab == "performance" ? "active" : "")" @onclick='() => _activeTab = "performance"'>
                        📊 Гүйцэтгэл
                    </button>
                </div>

                <!-- Tab: Attendance -->
                @if (_activeTab == "attendance")
                {
                    <div class="tab-content">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Огноо</th>
                                        <th>Гараг</th>
                                        <th>Ирсэн цаг</th>
                                        <th>Гарсан цаг</th>
                                        <th>Ажилласан</th>
                                        <th>Илүү цаг</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if ((_report?.AttendanceRecords?.Count ?? 0) == 0)
                                    {
                                        <tr class="empty-row">
                                            <td colspan="7">Ирцийн мэдээлэл олдсонгүй</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var record in _report.AttendanceRecords ?? new List<AttendanceRecord>())
                                        {
                                            <tr class="@GetRowClass(record.Status)">
                                                <td>@record.Date.ToString("yyyy-MM-dd")</td>
                                                <td class="text-muted">@GetDayName(record.Date)</td>
                                                <td>@(record.CheckIn?.ToString(@"HH\:mm") ?? "—")</td>
                                                <td>@(record.CheckOut?.ToString(@"HH\:mm") ?? "—")</td>
                                                <td>@(record.WorkedHours.HasValue ? (record.WorkedHours ?? 0).ToString("F1") + "ц" : "—")</td>
                                                <td class="@(record.OvertimeHours.GetValueOrDefault() > 0 ? "text-success" : "")">
                                                    @(record.OvertimeHours.GetValueOrDefault() > 0 ? "+" + (record.OvertimeHours ?? 0).ToString("F1") + "ц" : "—")
                                                </td>
                                                <td>
                                                    <span class="badge @GetBadgeClass(record.Status)">@record.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Tab: Overtime -->
                @if (_activeTab == "overtime")
                {
                    <div class="tab-content">
                        <div class="overtime-summary">
                            <div class="ot-card">
                                <div class="ot-value">@((_report?.OvertimeHours ?? 0.0).ToString("F1"))ц</div>
                                <div class="ot-label">Нийт илүү цаг</div>
                            </div>
                            <div class="ot-card">
                                <div class="ot-value">@((_report?.PresentDays > 0) ? ((_report?.OvertimeHours ?? 0.0) / (_report?.PresentDays ?? 1)).ToString("F1") : "0")ц</div>
                                <div class="ot-label">Дундаж өдөрт</div>
                            </div>
                            <div class="ot-card ot-card-danger">
                                <div class="ot-value">@((_report?.UndertimeHours ?? 0.0).ToString("F1"))ц</div>
                                <div class="ot-label">Дутуу цаг</div>
                            </div>
                        </div>

                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Огноо</th>
                                        <th>Ажилласан цаг</th>
                                        <th>Стандарт</th>
                                        <th>Илүү / дутуу</th>
                                        <th>Тэмдэглэл</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var overtimeRecords = (_report?.AttendanceRecords ?? [])
                                            .Where(x => x.OvertimeHours.GetValueOrDefault() != 0 || x.UndertimeHours.GetValueOrDefault() != 0)
                                            .ToList();
                                    }
                                    @if (overtimeRecords.Count == 0)
                                    {
                                        <tr class="empty-row">
                                            <td colspan="5">Цагийн зөрүү олдсонгүй</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var record in overtimeRecords)
                                        {
                                            <tr>
                                                <td>@record.Date.ToString("yyyy-MM-dd")</td>
                                                <td>@(record.WorkedHours?.ToString("F1") ?? "—")ц</td>
                                                <td>8.0ц</td>
                                                <td class="@(record.OvertimeHours.GetValueOrDefault() > 0 ? "text-success" : "text-danger")">
                                                    @if (record.OvertimeHours.GetValueOrDefault() > 0)
                                                    {
                                                        <span>+@(record.OvertimeHours ?? 0).ToString("F1")ц</span>
                                                    }
                                                    else if (record.UndertimeHours.GetValueOrDefault() > 0)
                                                    {
                                                        <span>-@(record.UndertimeHours ?? 0).ToString("F1")ц</span>
                                                    }
                                                </td>
                                                <td class="text-muted">@(record.Note ?? "—")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Tab: Leave -->
                @if (_activeTab == "leave")
                {
                    <div class="tab-content">
                        <div class="leave-balances">
                            @if ((_report?.LeaveBalances?.Count ?? 0) == 0)
                            {
                                <p class="text-muted">Чөлөөний баланс олдсонгүй</p>
                            }
                            else
                            {
                                @foreach (var balance in _report.LeaveBalances ?? new List<LeaveBalance>())
                                {
                                    <div class="leave-balance-card">
                                        <div class="balance-header">
                                            <span class="balance-type">@balance.LeaveType</span>
                                            <span class="balance-summary">@balance.Used / @balance.Total өдөр</span>
                                        </div>
                                        <div class="balance-bar">
                                            <div class="balance-fill" style="width: @(balance.Total > 0 ? Math.Min(balance.Used * 100 / balance.Total, 100) : 0)%"></div>
                                        </div>
                                        <div class="balance-footer">@balance.Remaining өдөр үлдсэн</div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="table-wrapper" style="margin-top: 20px;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Хүсэлт огноо</th>
                                        <th>Төрөл</th>
                                        <th>Эхлэх</th>
                                        <th>Дуусах</th>
                                        <th>Хоног</th>
                                        <th>Шалтгаан</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if ((_report.LeaveRequests?.Count ?? 0) == 0)
                                    {
                                        <tr class="empty-row">
                                            <td colspan="7">Чөлөөний хүсэлт олдсонгүй</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var leave in _report.LeaveRequests ?? new List<LeaveRequest>())
                                        {
                                            <tr>
                                                <td>@leave.RequestedAt.ToString("yyyy-MM-dd")</td>
                                                <td>@leave.LeaveType</td>
                                                <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                                                <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                                                <td>@leave.Days</td>
                                                <td class="text-muted">@(leave.Reason ?? "—")</td>
                                                <td>
                                                    <span class="badge @GetLeaveStatusBadge(leave.Status)">@leave.Status</span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- Tab: Performance -->
                @if (_activeTab == "performance")
                {
                    <div class="tab-content">
                        <div class="performance-grid">
                            <div class="perf-card">
                                <div class="perf-label">Ирцийн хувь</div>
                                <svg class="perf-circle" viewBox="0 0 100 100">
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#E5E7EB" stroke-width="8"/>
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#3B82F6" stroke-width="8"
                                            stroke-dasharray="@(2 * Math.PI * 45 * Math.Min(_report?.AttendanceRate ?? 0, 100) / 100) @(2 * Math.PI * 45)"
                                            stroke-linecap="round" transform="rotate(-90 50 50)"/>
                                    <text x="50" y="55" text-anchor="middle" font-size="24" font-weight="bold" fill="#1F2937">
                                        @((_report?.AttendanceRate ?? 0).ToString("F0"))%
                                    </text>
                                </svg>
                            </div>

                            <div class="perf-card">
                                <div class="perf-label">Цагийн нарийвчлал</div>
                                <svg class="perf-circle" viewBox="0 0 100 100">
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#E5E7EB" stroke-width="8"/>
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#10B981" stroke-width="8"
                                            stroke-dasharray="@(2 * Math.PI * 45 * Math.Min(_report?.PunctualityRate ?? 0, 100) / 100) @(2 * Math.PI * 45)"
                                            stroke-linecap="round" transform="rotate(-90 50 50)"/>
                                    <text x="50" y="55" text-anchor="middle" font-size="24" font-weight="bold" fill="#1F2937">
                                        @((_report?.PunctualityRate ?? 0).ToString("F0"))%
                                    </text>
                                </svg>
                            </div>
                        </div>

                        <div class="perf-stats">
                            <div class="stat-row">
                                <span>Дундаж ирэх цаг</span>
                                <span class="stat-value">@(_report?.AvgCheckIn ?? "—")</span>
                            </div>
                            <div class="stat-row">
                                <span>Дундаж гарах цаг</span>
                                <span class="stat-value">@(_report?.AvgCheckOut ?? "—")</span>
                            </div>
                            <div class="stat-row">
                                <span>Хамгийн их хоцорсон</span>
                                <span class="stat-value @(_report?.MaxLateMinutes > 0 ? "text-warning" : "")">
                                    @(_report?.MaxLateMinutes > 0 ? (_report?.MaxLateMinutes ?? 0) + " мин" : "—")
                                </span>
                            </div>
                            <div class="stat-row">
                                <span>Дараалсан ирсэн өдөр</span>
                                <span class="stat-value text-success">@(_report?.ConsecutivePresentDays ?? 0) өдөр</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (EmployeeId != default && !_loading)
        {
            <div class="empty-state">
                <div class="empty-icon">⚠️</div>
                <p>Тайлан олдсонгүй. Дахин оролдоно уу.</p>
            </div>
        }
    </div>
}

<style>
    :root {
        --primary: #3B82F6;
        --primary-light: #EFF6FF;
        --success: #10B981;
        --warning: #F59E0B;
        --danger: #EF4444;
        --info: #3B82F6;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-300: #D1D5DB;
        --gray-400: #9CA3AF;
        --gray-500: #6B7280;
        --gray-600: #4B5563;
        --gray-700: #374151;
        --gray-800: #1F2937;
        --gray-900: #111827;
    }

    .report-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 1200px;
    }

    /* Header */
    .report-header {
        background: white;
        border-radius: 8px;
        border: 1px solid var(--gray-200);
        padding: 1.5rem;
    }

    .report-header-top {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .btn-back {
        padding: 0.5rem 1rem;
        background: white;
        border: 1px solid var(--gray-300);
        border-radius: 6px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .btn-back:hover {
        background: var(--gray-50);
        border-color: var(--gray-400);
    }

    .report-header-title {
        flex: 1;
    }

    .report-header-title h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-900);
    }

    .subtitle {
        margin: 0.25rem 0 0 0;
        font-size: 0.9rem;
        color: var(--gray-500);
    }

    .report-header-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 6px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

    .btn-primary:hover:not(:disabled) {
        background: #2563EB;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .btn-secondary {
        background: var(--gray-100);
        color: var(--gray-700);
    }

    .btn-secondary:hover:not(:disabled) {
        background: var(--gray-200);
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* Alert */
    .alert {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid;
    }

    .alert-error {
        background: #FEF2F2;
        border-color: #FECACA;
        color: #DC2626;
    }

    .alert-close {
        margin-left: auto;
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: inherit;
    }

    /* Controls */
    .controls-panel {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .control-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .control-group label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--gray-700);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .control-group select,
    .control-group input {
        padding: 0.625rem;
        border: 1px solid var(--gray-300);
        border-radius: 6px;
        font-size: 0.9rem;
        font-family: inherit;
        transition: border-color 0.2s;
    }

    .control-group select:focus,
    .control-group input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-light);
    }

    .shortcuts {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .shortcuts label {
        font-weight: 600;
        color: var(--gray-700);
    }

    .shortcut-btn {
        padding: 0.5rem 1rem;
        border: 1px solid var(--gray-300);
        background: white;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .shortcut-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    .shortcut-btn.active {
        background: var(--primary-light);
        border-color: var(--primary);
        color: var(--primary);
        font-weight: 600;
    }

    /* Empty & Loading */
    .empty-state,
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 4rem 2rem;
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        color: var(--gray-500);
    }

    .empty-icon {
        font-size: 3rem;
        opacity: 0.3;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid var(--gray-200);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .spinner-small {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .spinner-small.spinner-dark {
