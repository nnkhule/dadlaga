@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private const double StandardWorkHours = 8.0;
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private string _activeTab = "attendance";
    private string _period = "month";
    private DateOnly _from = DateOnly.FromDateTime(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1));
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);

    private bool _loading;
    private bool _loadingEmployees = true;
    private bool _exporting;
    private bool _exportingExcel;
    private string? _loadError;

    private Guid _loadedEmployeeId;
    private CancellationTokenSource? _reportCts;

    private EmployeeReportDto? _report;
    private List<EmployeeListItem> _employees = [];
    private EmployeeListItem? _employee => _employees.FirstOrDefault(e => e.Id == EmployeeId);

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EmployeeId == default)
        {
            _report = null;
            _loadedEmployeeId = default;
            return;
        }

        // URL-аар ажилтан солигдсон үед л дахин ачаална (давхар дуудлагаас сэргийлнэ)
        if (EmployeeId != _loadedEmployeeId)
            await LoadReport();
    }

    private async Task LoadEmployees()
    {
        _loadingEmployees = true;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            using var req = await BuildRequestAsync(HttpMethod.Get, "api/employees?pageNumber=1&pageSize=200");
            using var resp = await Http.SendAsync(req, cts.Token);

            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<PagedResult<EmployeeListItem>>(cts.Token);
                _employees = result?.Items ?? [];
            }
            else
            {
                _loadError = $"Ажилтнуудын жагсаалтыг ачаалж чадсангүй ({(int)resp.StatusCode}).";
            }
        }
        catch (OperationCanceledException)
        {
            _loadError = "Ажилтнуудыг ачаалах хугацаа хэтэрлээ. Сервер ажиллаж байгаа эсэхийг шалгана уу.";
        }
        catch
        {
            _loadError = "Ажилтнуудыг ачааллахад алдаа гарлаа.";
        }
        finally
        {
            _loadingEmployees = false;
        }
    }

    private async Task LoadReport()
    {
        if (EmployeeId == default) return;

        if (_from > _to)
        {
            _loadError = "Эхлэх огноо нь дуусах огнооноос хойш байж болохгүй.";
            return;
        }

        // Өмнөх хүсэлтийг цуцлана — хариу сольж ирэх (race condition) асуудлаас сэргийлнэ
        _reportCts?.Cancel();
        _reportCts?.Dispose();
        var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        _reportCts = cts;

        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var url = $"api/reports/employee/{EmployeeId}?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}";
            using var req = await BuildRequestAsync(HttpMethod.Get, url);
            using var resp = await Http.SendAsync(req, cts.Token);

            if (cts.IsCancellationRequested) return;

            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<EmployeeReportDto>(cts.Token) ?? new EmployeeReportDto();
                dto.AttendanceRecords ??= [];
                dto.LeaveRequests ??= [];
                dto.LeaveBalances ??= [];
                _report = dto;
                _loadedEmployeeId = EmployeeId;
            }
            else
            {
                _report = null;
                _loadError = $"Тайлан ачааллахад алдаа гарлаа ({(int)resp.StatusCode}). Дахин оролдоно уу.";
            }
        }
        catch (OperationCanceledException)
        {
            // Шинэ хүсэлтээр солигдсон бол дуугүй өнгөрнө
            if (!ReferenceEquals(_reportCts, cts)) return;
            _loadError = "Тайлан ачаалах хугацаа хэтэрлээ.";
        }
        catch
        {
            _loadError = "Сервертэй холбогдоход алдаа гарлаа.";
        }
        finally
        {
            if (ReferenceEquals(_reportCts, cts))
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task<HttpRequestMessage> BuildRequestAsync(HttpMethod method, string url)
    {
        var token = await Auth.GetTokenAsync();
        var req = new HttpRequestMessage(method, url);
        if (!string.IsNullOrWhiteSpace(token))
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return req;
    }

    private async Task SetPeriod(string p)
    {
        _period = p;
        var today = DateTime.Today;
        (_from, _to) = p switch
        {
            "month"  => (DateOnly.FromDateTime(new DateTime(today.Year, today.Month, 1)), DateOnly.FromDateTime(today)),
            "3month" => (DateOnly.FromDateTime(today.AddMonths(-3)), DateOnly.FromDateTime(today)),
            "6month" => (DateOnly.FromDateTime(today.AddMonths(-6)), DateOnly.FromDateTime(today)),
            "year"   => (DateOnly.FromDateTime(new DateTime(today.Year, 1, 1)), DateOnly.FromDateTime(today)),
            _ => (_from, _to)
        };
        await LoadReport();
    }

    private async Task OnDateChanged()
    {
        _period = string.Empty; // гар аргаар огноо сонгосон бол товч идэвхгүй болно
        if (_from > _to)
        {
            _loadError = "Эхлэх огноо нь дуусах огнооноос хойш байж болохгүй.";
            return;
        }
        _loadError = null;
        await LoadReport();
    }

    private void OnEmployeeChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (Guid.TryParse(value, out var id) && id != default)
        {
            Nav.NavigateTo($"/admin/reports/employee/{id}");
            return;
        }

        _report = null;
        _loadedEmployeeId = default;
        Nav.NavigateTo("/admin/reports/employee");
    }

    private Task ExportPdf() => ExportAsync(
        $"api/reports/employee/{EmployeeId}/pdf?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}",
        $"tailan_{FileTag()}.pdf", "application/pdf", isPdf: true);

    private Task ExportExcel() => ExportAsync(
        $"api/reports/employee/{EmployeeId}/excel?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}",
        $"tailan_{FileTag()}.xlsx",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", isPdf: false);

    private async Task ExportAsync(string url, string fallbackName, string fallbackMime, bool isPdf)
    {
        if (EmployeeId == default) return;

        if (isPdf) _exporting = true; else _exportingExcel = true;
        _loadError = null;

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            using var req = await BuildRequestAsync(HttpMethod.Get, url);
            using var resp = await Http.SendAsync(req, cts.Token);

            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync(cts.Token);

                // Серверийн өгсөн нэр/төрлийг эхэнд нь авна, байхгүй бол fallback
                var name = resp.Content.Headers.ContentDisposition?.FileNameStar
                           ?? resp.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                           ?? fallbackName;
                var mime = resp.Content.Headers.ContentType?.MediaType ?? fallbackMime;

                await DownloadFile(bytes, name, mime);
            }
            else
            {
                _loadError = isPdf
                    ? $"PDF файл үүсгэхэд алдаа гарлаа ({(int)resp.StatusCode})."
                    : $"Excel файл үүсгэхэд алдаа гарлаа ({(int)resp.StatusCode}).";
            }
        }
        catch (OperationCanceledException)
        {
            _loadError = "Файл үүсгэх хугацаа хэтэрлээ.";
        }
        catch
        {
            _loadError = isPdf ? "PDF татахад алдаа гарлаа." : "Excel татахад алдаа гарлаа.";
        }
        finally
        {
            if (isPdf) _exporting = false; else _exportingExcel = false;
        }
    }

    private string FileTag()
    {
        var code = _employee?.EmployeeCode;
        if (string.IsNullOrWhiteSpace(code)) code = EmployeeId.ToString("N")[..8];
        return $"{code}_{_from:yyyyMMdd}-{_to:yyyyMMdd}";
    }

    private async Task DownloadFile(byte[] bytes, string fileName, string mimeType)
    {
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64File", b64, fileName, mimeType);
    }

    private void GoBack() => Nav.NavigateTo("/admin/reports");

    public void Dispose()
    {
        _reportCts?.Cancel();
        _reportCts?.Dispose();
    }

    // ── Тоо форматлах (CSS/SVG-д заавал InvariantCulture байх ёстой) ──
    private static double Clamp(double v) => Math.Clamp(v, 0, 100);
    private static string F0(double v) => v.ToString("F0", Inv);
    private static string F1(double v) => v.ToString("F1", Inv);
    private static string Css(double v) => v.ToString("0.###", Inv);

    private static string Dash(double percent)
    {
        const double r = 45;
        var circumference = 2 * Math.PI * r;
        var filled = circumference * Clamp(percent) / 100;
        return $"{Css(filled)} {Css(circumference)}";
    }

    private static string GetDayName(DateOnly d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday    => "Да",
        DayOfWeek.Tuesday   => "Мя",
        DayOfWeek.Wednesday => "Лх",
        DayOfWeek.Thursday  => "Пү",
        DayOfWeek.Friday    => "Ба",
        DayOfWeek.Saturday  => "Бя",
        DayOfWeek.Sunday    => "Ня",
        _ => ""
    };

    private static string GetRowClass(string? status) => Normalize(status) switch
    {
        "absent" => "row-absent",
        "late"   => "row-late",
        _ => ""
    };

    private static string GetBadgeClass(string? status) => Normalize(status) switch
    {
        "present" => "badge-present",
        "late"    => "badge-late",
        "absent"  => "badge-absent",
        _ => "badge-default"
    };

    private static string GetLeaveStatusBadge(string? status) => Normalize(status) switch
    {
        "approved" => "badge-approved",
        "pending"  => "badge-pending",
        "rejected" => "badge-rejected",
        _ => "badge-default"
    };

    // API монгол эсвэл англи утга буцаасан ч ажиллана
    private static string Normalize(string? status) => (status ?? "").Trim() switch
    {
        "Ирсэн" or "Present" => "present",
        "Хоцорсон" or "Late" => "late",
        "Тасалсан" or "Absent" => "absent",
        "Зөвшөөрсөн" or "Approved" => "approved",
        "Хүлээгдэж буй" or "Pending" => "pending",
        "Татгалзсан" or "Rejected" => "rejected",
        _ => ""
    };

