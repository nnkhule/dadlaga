@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private string _activeTab = "attendance";
    private string _period = "month";
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Today.AddDays(-DateTime.Today.Day + 1));
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);

    private bool _showInitialSpinner;
    private bool _loading;
    private bool _loadingEmployees;
    private bool _exporting;
    private bool _exportingExcel;
    private bool _initialized;
    private string? _loadError;

    private EmployeeReportDto? _report;
    private List<EmployeeListItem> _employees = [];
    private EmployeeListItem? _employee => _employees.FirstOrDefault(e => e.Id == EmployeeId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Set _initialized FIRST so that if OnParametersSetAsync fires
        // concurrently (e.g. hot-reload or re-render), it won't double-load.
        _initialized = true;

        _showInitialSpinner = true;
        await LoadEmployees();
        if (EmployeeId != default) await LoadReport();
        _showInitialSpinner = false;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && EmployeeId != default) await LoadReport();
    }

    private async Task LoadEmployees()
    {
        _loadingEmployees = true;
        try
        {
            var token = await Auth.GetTokenAsync();
            using var req = new HttpRequestMessage(HttpMethod.Get, "api/employees?pageNumber=1&pageSize=100");
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var resp = await Http.SendAsync(req, cts.Token);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<PagedResult<EmployeeListItem>>(cts.Token);
                _employees = result?.Items ?? [];
            }
            else
            {
                _loadError = $"Failed to load employees ({(int)resp.StatusCode}).";
            }
        }
        catch (OperationCanceledException)
        {
            _loadError = "Loading employees timed out. Check that the API is running.";
        }
        catch
        {
            _loadError = "Ажилтнуудыг ачааллахад алдаа гарлаа";
        }
        finally { _loadingEmployees = false; }
    }

    private async Task LoadReport()
    {
        if (EmployeeId == default) return;

        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var token = await Auth.GetTokenAsync();
            var url = $"api/reports/employee/{EmployeeId}?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}";
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var resp = await Http.SendAsync(req);

            if (resp.IsSuccessStatusCode)
            {
                _report = await resp.Content.ReadFromJsonAsync<EmployeeReportDto>();

                if (_report == null)
                    _report = new EmployeeReportDto();

                _report.AttendanceRecords ??= [];
                _report.LeaveRequests ??= [];
                _report.LeaveBalances ??= [];
            }
            else
            {
                _loadError = "Тайлан ачааллахад алдаа гарлаа. Дахин оролдоно уу.";
            }
        }
        catch
        {
            _loadError = "Сервертэй холбогдоход алдаа гарлаа";
        }
        finally { _loading = false; }
    }


    private async Task SetPeriod(string p)
    {
        _period = p;
        var today = DateTime.Today;
        (_from, _to) = p switch
        {
            "month"  => (DateOnly.FromDateTime(new DateTime(today.Year, today.Month, 1)), DateOnly.FromDateTime(today)),
            "3month" => (DateOnly.FromDateTime(today.AddMonths(-3)), DateOnly.FromDateTime(today)),
            "6month" => (DateOnly.FromDateTime(today.AddMonths(-6)), DateOnly.FromDateTime(today)),
            "year"   => (DateOnly.FromDateTime(new DateTime(today.Year, 1, 1)), DateOnly.FromDateTime(today)),
            _ => (_from, _to)
        };
        await LoadReport();
    }

    private void OnEmployeeChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (Guid.TryParse(value, out var employeeId))
        {
            Nav.NavigateTo($"/admin/reports/employee/{employeeId}");
            return;
        }

        _report = null;
        Nav.NavigateTo("/admin/reports/employee");
    }

    private async Task ExportPdf()
    {
        if (EmployeeId == default) return;
        _exporting = true;
        try
        {
            var token = await Auth.GetTokenAsync();
            var url = $"api/reports/employee/{EmployeeId}/pdf?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}";
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var resp = await Http.SendAsync(req);

            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                await DownloadFile(bytes, $"report_{_employee?.EmployeeCode}_{_from:yyyyMM}.txt", "text/plain");
            }
            else
                _loadError = "PDF файл үүсгэхэд алдаа гарлаа";
        }
        catch { _loadError = "PDF татахад алдаа гарлаа"; }
        finally { _exporting = false; }
    }

    private async Task ExportExcel()
    {
        if (EmployeeId == default) return;
        _exportingExcel = true;
        try
        {
            var token = await Auth.GetTokenAsync();
            var url = $"api/reports/employee/{EmployeeId}/excel?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}";
            using var req = new HttpRequestMessage(HttpMethod.Get, url);
            req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var resp = await Http.SendAsync(req);

            if (resp.IsSuccessStatusCode)
            {
                var bytes = await resp.Content.ReadAsByteArrayAsync();
                await DownloadFile(bytes, $"report_{_employee?.EmployeeCode}_{_from:yyyyMM}.csv", "text/csv");
            }
            else
                _loadError = "Excel файл үүсгэхэд алдаа гарлаа";
        }
        catch { _loadError = "Excel татахад алдаа гарлаа"; }
        finally { _exportingExcel = false; }
    }

    private async Task DownloadFile(byte[] bytes, string fileName, string mimeType)
    {
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64File", b64, fileName, mimeType);
    }

    private void GoBack() => Nav.NavigateTo("/admin/reports");

    private static string GetDayName(DateOnly d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday    => "Да",
        DayOfWeek.Tuesday   => "Мя",
        DayOfWeek.Wednesday => "Лх",
        DayOfWeek.Thursday  => "Пү",
        DayOfWeek.Friday    => "Ба",
        DayOfWeek.Saturday  => "Бя",
        DayOfWeek.Sunday    => "Ня",
        _ => ""
    };

    private static string GetRowClass(string status) => status switch
    {
        "Тасалсан" => "row-absent",
        "Хоцорсон" => "row-late",
        _ => ""
    };

    private static string GetBadgeClass(string status) => status switch
    {
        "Ирсэн"    => "badge-present",
        "Хоцорсон" => "badge-late",
        "Тасалсан" => "badge-absent",
        _ => "badge-default"
    };

    private static string GetLeaveStatusBadge(string status) => status switch
    {
        "Зөвшөөрсөн"    => "badge-approved",
        "Хүлээгдэж буй" => "badge-pending",
        "Татгалзсан"    => "badge-rejected",
        _ => "badge-default"
    };

    // ── DTOs ──────────────────────────────────────────────────────────────────
    private sealed record EmployeeListItem(Guid Id, string EmployeeCode, string FullName, string? Department, string? DepartmentName);
    private sealed class PagedResult<T> { public List<T> Items { get; set; } = []; }

    private sealed class EmployeeReportDto
    {
        public int TotalWorkDays { get; set; }
        public int PresentDays { get; set; }
        public int LateDays { get; set; }
        public int AbsentDays { get; set; }
        public double OvertimeHours { get; set; }
        public double UndertimeHours { get; set; }
        public int LeaveDays { get; set; }
        public int LeaveBalance { get; set; }
        public double AttendanceRate { get; set; }
        public double PunctualityRate { get; set; }
        public string? AvgCheckIn { get; set; }
        public string? AvgCheckOut { get; set; }
        public int MaxLateMinutes { get; set; }
        public int ConsecutivePresentDays { get; set; }
        public List<AttendanceRecord> AttendanceRecords { get; set; } = [];
        public List<LeaveRequest> LeaveRequests { get; set; } = [];
        public List<LeaveBalance> LeaveBalances { get; set; } = [];
    }

    private sealed class AttendanceRecord
    {
        public DateOnly Date { get; set; }
        public TimeOnly? CheckIn { get; set; }
        public TimeOnly? CheckOut { get; set; }
        public double? WorkedHours { get; set; }
        public double? OvertimeHours { get; set; }
        public double? UndertimeHours { get; set; }
        public string Status { get; set; } = "";
        public string? Note { get; set; }
    }

    private sealed class LeaveRequest
    {
        public DateTime RequestedAt { get; set; }
        public string LeaveType { get; set; } = "";
        public DateOnly StartDate { get; set; }
        public DateOnly EndDate { get; set; }
        public int Days { get; set; }
        public string? Reason { get; set; }
        public string Status { get; set; } = "";
    }

    private sealed class LeaveBalance
    {
        public string LeaveType { get; set; } = "";
        public int Total { get; set; }
        public int Used { get; set; }
        public int Remaining { get; set; }
    }
}
