@page "/admin/reports/employee"
@page "/admin/reports/employee/{EmployeeId:guid}"

@layout AdminLayout
@attribute [Authorize(Roles = "SuperAdmin,HRManager,DepartmentHead")]
@implements IDisposable
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Ажилтны тайлан — AttendIQ</PageTitle>

<div class="report-page">
@if (_loadingEmployees && _employees.Count == 0)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Ачааллаж байна...</p>
    </div>
}
else
{
    <div class="report-container">
        <!-- ── Header ── -->
        <div class="report-header">
            <div class="report-header-top">
                <button class="btn-back" @onclick="GoBack">
                    <span aria-hidden="true">←</span> Буцах
                </button>
                <div class="report-header-title">
                    <h1>Ажилтны хувийн тайлан</h1>
                    @if (_employee is not null)
                    {
                        <p class="subtitle">@_employee.FullName · @_employee.EmployeeCode</p>
                    }
                </div>
                @if (_employee is not null && _report is not null)
                {
                    <div class="report-header-actions">
                        <button class="btn btn-primary" @onclick="ExportPdf" disabled="@(_exporting || _exportingExcel)">
                            @if (_exporting)
                            {
                                <span class="spinner-small"></span>
                                <span>Үүсгэж байна...</span>
                            }
                            else
                            {
                                <span aria-hidden="true">📄</span>
                                <span>PDF татах</span>
                            }
                        </button>
                        <button class="btn btn-secondary" @onclick="ExportExcel" disabled="@(_exporting || _exportingExcel)">
                            @if (_exportingExcel)
                            {
                                <span class="spinner-small spinner-dark"></span>
                                <span>Үүсгэж байна...</span>
                            }
                            else
                            {
                                <span aria-hidden="true">📊</span>
                                <span>Excel татах</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- ── Алдааны мэдэгдэл ── -->
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <div class="alert alert-error" role="alert">
                <span aria-hidden="true">⚠️</span>
                <span>@_loadError</span>
                <button class="alert-close" title="Хаах" @onclick="() => _loadError = null">✕</button>
            </div>
        }

        <!-- ── Шүүлтүүр ── -->
        <div class="controls-panel">
            <div class="control-row">
                <div class="control-group">
                    <label for="empSelect">Ажилтан</label>
                    <select id="empSelect"
                            value="@(EmployeeId == default ? string.Empty : EmployeeId.ToString())"
                            @onchange="OnEmployeeChange"
                            disabled="@_loadingEmployees">
                        <option value="">— Ажилтан сонгох —</option>
                        @foreach (var emp in _employees)
                        {
                            <option value="@emp.Id">@emp.FullName (@emp.EmployeeCode)</option>
                        }
                    </select>
                </div>

                <div class="control-group">
                    <label for="dateFrom">Эхлэх огноо</label>
                    <input id="dateFrom" type="date" max="@_to.ToString("yyyy-MM-dd")"
                           @bind="_from" @bind:after="OnDateChanged" />
                </div>

                <div class="control-group">
                    <label for="dateTo">Дуусах огноо</label>
                    <input id="dateTo" type="date" min="@_from.ToString("yyyy-MM-dd")"
                           @bind="_to" @bind:after="OnDateChanged" />
                </div>
            </div>

            <div class="shortcuts">
                <span class="shortcuts-label">Хурдан сонголт:</span>
                <button class="shortcut-btn @(_period == "month" ? "active" : "")" @onclick='() => SetPeriod("month")'>Энэ сар</button>
                <button class="shortcut-btn @(_period == "3month" ? "active" : "")" @onclick='() => SetPeriod("3month")'>3 сар</button>
                <button class="shortcut-btn @(_period == "6month" ? "active" : "")" @onclick='() => SetPeriod("6month")'>6 сар</button>
                <button class="shortcut-btn @(_period == "year" ? "active" : "")" @onclick='() => SetPeriod("year")'>Энэ жил</button>
            </div>
        </div>

        <!-- ── Төлөв ── -->
        @if (EmployeeId == default)
        {
            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true">📋</div>
                <p>Тайлан харахын тулд ажилтан сонгоно уу.</p>
            </div>
        }
        else if (_loading && _report is null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Тайлан ачааллаж байна...</p>
            </div>
        }
        else if (_report is not null)
        {
            <div class="report-body @(_loading ? "is-busy" : "")">
            <!-- Хураангуй -->
            <div class="summary-cards">
                <div class="card card-stat">
                    <div class="stat-number">@_report.TotalWorkDays</div>
                    <div class="stat-label">Нийт ажлын өдөр</div>
                </div>
                <div class="card card-stat card-success">
                    <div class="stat-number">@_report.PresentDays</div>
                    <div class="stat-label">Ирсэн өдөр</div>
                    <div class="stat-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @Css(Clamp(_report.AttendanceRate))%"></div>
                        </div>
                        <span class="progress-text">@F0(_report.AttendanceRate)%</span>
                    </div>
                </div>
                <div class="card card-stat card-warning">
                    <div class="stat-number">@_report.LateDays</div>
                    <div class="stat-label">Хоцорсон өдөр</div>
                </div>
                <div class="card card-stat card-danger">
                    <div class="stat-number">@_report.AbsentDays</div>
                    <div class="stat-label">Тасалсан өдөр</div>
                </div>
                <div class="card card-stat card-info">
                    <div class="stat-number">@F1(_report.OvertimeHours)</div>
                    <div class="stat-label">Илүү цаг</div>
                    <div class="stat-sub">цаг</div>
                </div>
                <div class="card card-stat">
                    <div class="stat-number">@_report.LeaveDays</div>
                    <div class="stat-label">Чөлөө авсан</div>
                    <div class="stat-sub">@_report.LeaveBalance өдөр үлдсэн</div>
                </div>
            </div>

            <!-- Табууд -->
            <div class="tabs-container">
                <div class="tabs" role="tablist">
                    <button class="tab @(_activeTab == "attendance" ? "active" : "")" @onclick='() => _activeTab = "attendance"'>📅 Ирцийн түүх</button>
                    <button class="tab @(_activeTab == "overtime" ? "active" : "")" @onclick='() => _activeTab = "overtime"'>⏱️ Цагийн тооцоо</button>
                    <button class="tab @(_activeTab == "leave" ? "active" : "")" @onclick='() => _activeTab = "leave"'>✓ Чөлөө</button>
                    <button class="tab @(_activeTab == "performance" ? "active" : "")" @onclick='() => _activeTab = "performance"'>📊 Гүйцэтгэл</button>
                </div>

                @if (_activeTab == "attendance")
                {
                    <div class="tab-content">
                        <div class="table-wrapper table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Огноо</th>
                                        <th>Гараг</th>
                                        <th>Ирсэн цаг</th>
                                        <th>Гарсан цаг</th>
                                        <th>Ажилласан</th>
                                        <th>Илүү цаг</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_report.AttendanceRecords.Count == 0)
                                    {
                                        <tr class="empty-row"><td colspan="7">Ирцийн мэдээлэл олдсонгүй</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var record in _report.AttendanceRecords)
                                        {
                                            <tr class="@GetRowClass(record.Status)">
                                                <td>@record.Date.ToString("yyyy-MM-dd")</td>
                                                <td class="text-muted">@GetDayName(record.Date)</td>
                                                <td>@(record.CheckIn?.ToString(@"HH\:mm") ?? "—")</td>
                                                <td>@(record.CheckOut?.ToString(@"HH\:mm") ?? "—")</td>
                                                <td>@(record.WorkedHours.HasValue ? F1(record.WorkedHours.Value) + "ц" : "—")</td>
                                                <td class="@(record.OvertimeHours.GetValueOrDefault() > 0 ? "text-success" : "")">
                                                    @(record.OvertimeHours.GetValueOrDefault() > 0
                                                        ? "+" + F1(record.OvertimeHours!.Value) + "ц"
                                                        : "—")
                                                </td>
                                                <td><span class="badge @GetBadgeClass(record.Status)">@record.Status</span></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (_activeTab == "overtime")
                {
                    <div class="tab-content">
                        <div class="overtime-summary">
                            <div class="ot-card">
                                <div class="ot-value">@F1(_report.OvertimeHours)ц</div>
                                <div class="ot-label">Нийт илүү цаг</div>
                            </div>
                            <div class="ot-card">
                                <div class="ot-value">@F1(_report.PresentDays > 0 ? _report.OvertimeHours / _report.PresentDays : 0)ц</div>
                                <div class="ot-label">Дундаж өдөрт</div>
                            </div>
                            <div class="ot-card ot-card-danger">
                                <div class="ot-value">@F1(_report.UndertimeHours)ц</div>
                                <div class="ot-label">Дутуу цаг</div>
                            </div>
                        </div>

                        @{
                            var overtimeRecords = _report.AttendanceRecords
                                .Where(x => x.OvertimeHours.GetValueOrDefault() != 0 || x.UndertimeHours.GetValueOrDefault() != 0)
                                .ToList();
                        }
                        <div class="table-wrapper table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Огноо</th>
                                        <th>Ажилласан цаг</th>
                                        <th>Стандарт</th>
                                        <th>Илүү / дутуу</th>
                                        <th>Тэмдэглэл</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (overtimeRecords.Count == 0)
                                    {
                                        <tr class="empty-row"><td colspan="5">Цагийн зөрүү олдсонгүй</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var record in overtimeRecords)
                                        {
                                            <tr>
                                                <td>@record.Date.ToString("yyyy-MM-dd")</td>
                                                <td>@(record.WorkedHours.HasValue ? F1(record.WorkedHours.Value) + "ц" : "—")</td>
                                                <td>@F1(StandardWorkHours)ц</td>
                                                <td class="@(record.OvertimeHours.GetValueOrDefault() > 0 ? "text-success" : "text-danger")">
                                                    @if (record.OvertimeHours.GetValueOrDefault() > 0)
                                                    {
                                                        <span>+@F1(record.OvertimeHours!.Value)ц</span>
                                                    }
                                                    else if (record.UndertimeHours.GetValueOrDefault() > 0)
                                                    {
                                                        <span>-@F1(record.UndertimeHours!.Value)ц</span>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                <td class="text-muted">@(string.IsNullOrWhiteSpace(record.Note) ? "—" : record.Note)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (_activeTab == "leave")
                {
                    <div class="tab-content">
                        <div class="leave-balances">
                            @if (_report.LeaveBalances.Count == 0)
                            {
                                <p class="text-muted">Чөлөөний баланс олдсонгүй</p>
                            }
                            else
                            {
                                @foreach (var balance in _report.LeaveBalances)
                                {
                                    var pct = balance.Total > 0 ? Clamp(balance.Used * 100.0 / balance.Total) : 0;
                                    <div class="leave-balance-card">
                                        <div class="balance-header">
                                            <span class="balance-type">@balance.LeaveType</span>
                                            <span class="balance-summary">@balance.Used / @balance.Total өдөр</span>
                                        </div>
                                        <div class="balance-bar">
                                            <div class="balance-fill" style="width: @Css(pct)%"></div>
                                        </div>
                                        <div class="balance-footer">@balance.Remaining өдөр үлдсэн</div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="table-wrapper table-scroll" style="margin-top: 1.25rem;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Хүсэлт огноо</th>
                                        <th>Төрөл</th>
                                        <th>Эхлэх</th>
                                        <th>Дуусах</th>
                                        <th>Хоног</th>
                                        <th>Шалтгаан</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_report.LeaveRequests.Count == 0)
                                    {
                                        <tr class="empty-row"><td colspan="7">Чөлөөний хүсэлт олдсонгүй</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var leave in _report.LeaveRequests)
                                        {
                                            <tr>
                                                <td>@leave.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                                <td>@leave.LeaveType</td>
                                                <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                                                <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                                                <td>@leave.Days</td>
                                                <td class="text-muted">@(string.IsNullOrWhiteSpace(leave.Reason) ? "—" : leave.Reason)</td>
                                                <td><span class="badge @GetLeaveStatusBadge(leave.Status)">@leave.Status</span></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (_activeTab == "performance")
                {
                    <div class="tab-content">
                        <div class="performance-grid">
                            <div class="perf-card">
                                <div class="perf-label">Ирцийн хувь</div>
                                <svg class="perf-circle" viewBox="0 0 100 100" role="img" aria-label="Ирцийн хувь">
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#E5E7EB" stroke-width="8" />
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#3B82F6" stroke-width="8"
                                            stroke-dasharray="@Dash(_report.AttendanceRate)"
                                            stroke-linecap="round" transform="rotate(-90 50 50)" />
                                    <text x="50" y="55" text-anchor="middle" font-size="22" font-weight="bold" fill="#1F2937">
                                        @F0(_report.AttendanceRate)%
                                    </text>
                                </svg>
                            </div>

                            <div class="perf-card">
                                <div class="perf-label">Цагийн нарийвчлал</div>
                                <svg class="perf-circle" viewBox="0 0 100 100" role="img" aria-label="Цагийн нарийвчлал">
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#E5E7EB" stroke-width="8" />
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="#10B981" stroke-width="8"
                                            stroke-dasharray="@Dash(_report.PunctualityRate)"
                                            stroke-linecap="round" transform="rotate(-90 50 50)" />
                                    <text x="50" y="55" text-anchor="middle" font-size="22" font-weight="bold" fill="#1F2937">
                                        @F0(_report.PunctualityRate)%
                                    </text>
                                </svg>
                            </div>
                        </div>

                        <div class="perf-stats">
                            <div class="stat-row">
                                <span>Дундаж ирэх цаг</span>
                                <span class="stat-value">@(string.IsNullOrWhiteSpace(_report.AvgCheckIn) ? "—" : _report.AvgCheckIn)</span>
                            </div>
                            <div class="stat-row">
                                <span>Дундаж гарах цаг</span>
                                <span class="stat-value">@(string.IsNullOrWhiteSpace(_report.AvgCheckOut) ? "—" : _report.AvgCheckOut)</span>
                            </div>
                            <div class="stat-row">
                                <span>Хамгийн их хоцорсон</span>
                                <span class="stat-value @(_report.MaxLateMinutes > 0 ? "text-warning" : "")">
                                    @(_report.MaxLateMinutes > 0 ? _report.MaxLateMinutes + " мин" : "—")
                                </span>
                            </div>
                            <div class="stat-row">
                                <span>Дараалсан ирсэн өдөр</span>
                                <span class="stat-value text-success">@_report.ConsecutivePresentDays өдөр</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true">⚠️</div>
                <p>Тайлан олдсонгүй. Дахин оролдоно уу.</p>
            </div>
        }
    </div>
}
</div>

<style>
    /* Хувьсагчид зөвхөн энэ хуудсанд — :root ашиглахгүй (global leak болдог) */
    .report-page {
        --primary: #3B82F6;
        --primary-dark: #2563EB;
        --primary-light: #EFF6FF;
        --success: #10B981;
        --warning: #F59E0B;
        --danger: #EF4444;
        --info: #3B82F6;
        --gray-50: #F9FAFB;
        --gray-100: #F3F4F6;
        --gray-200: #E5E7EB;
        --gray-300: #D1D5DB;
        --gray-400: #9CA3AF;
        --gray-500: #6B7280;
        --gray-600: #4B5563;
        --gray-700: #374151;
        --gray-800: #1F2937;
        --gray-900: #111827;

        /* Дэлгэцийн хэмжээнээс хамаарсан зай/фонт */
        --pad-card: clamp(0.875rem, 1.1vw, 1.5rem);
        --gap: clamp(0.75rem, 1vw, 1.5rem);
        --radius: 10px;
        --shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 1px 3px rgba(16, 24, 40, 0.06);
    }

    .report-page * { box-sizing: border-box; }

    .report-container {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        width: 100%;
        max-width: 1440px;
        margin-inline: auto;
    }

    .report-body {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        transition: opacity 0.15s ease;
    }

    .report-body.is-busy { opacity: 0.55; pointer-events: none; }

    /* ── Header ── */
    .report-header {
        background: white;
        border-radius: var(--radius);
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow);
        padding: var(--pad-card);
    }

    .report-header-top {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .report-page .btn-back {
        padding: 0.5rem 0.9rem;
        background: white;
        border: 1px solid var(--gray-300);
        border-radius: 8px;
        font-size: 0.875rem;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
    }

    .report-page .btn-back:hover { background: var(--gray-50); border-color: var(--gray-400); }

    .report-header-title { flex: 1 1 240px; min-width: 0; }

    .report-header-title h1 {
        margin: 0;
        font-size: clamp(1.15rem, 1.4vw, 1.5rem);
        font-weight: 700;
        color: var(--gray-900);
        line-height: 1.25;
    }

    .subtitle {
        margin: 0.25rem 0 0;
        font-size: 0.875rem;
        color: var(--gray-500);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .report-header-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

    .report-page .btn {
        padding: 0.55rem 1.05rem;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .report-page .btn-primary { background: var(--primary); color: white; }
    .report-page .btn-primary:hover:not(:disabled) { background: var(--primary-dark); box-shadow: 0 4px 12px rgba(59,130,246,0.28); }
    .report-page .btn-secondary { background: var(--gray-100); color: var(--gray-700); }
    .report-page .btn-secondary:hover:not(:disabled) { background: var(--gray-200); }
    .report-page .btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ── Alert ── */
    .report-page .alert {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1rem;
        border-radius: var(--radius);
        border: 1px solid;
        font-size: 0.9rem;
    }

    .report-page .alert-error { background: #FEF2F2; border-color: #FECACA; color: #DC2626; }

    .report-page .alert-close {
        margin-left: auto;
        background: none;
        border: none;
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
        color: inherit;
    }

    /* ── Шүүлтүүр ── */
    .controls-panel {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: var(--pad-card);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .control-row {
        display: grid;
        grid-template-columns: minmax(220px, 2fr) minmax(150px, 1fr) minmax(150px, 1fr);
        gap: 0.875rem;
    }

    .control-group { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }

    .control-group label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--gray-600);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .control-group select,
    .control-group input {
        width: 100%;
        padding: 0.55rem 0.65rem;
        border: 1px solid var(--gray-300);
        border-radius: 8px;
        font-size: 0.875rem;
        font-family: inherit;
        background: white;
        color: var(--gray-900);
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .control-group select:focus,
    .control-group input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-light);
    }

    .shortcuts { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

