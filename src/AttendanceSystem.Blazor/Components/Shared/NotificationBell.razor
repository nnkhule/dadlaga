@inject AttendanceSystem.Blazor.Services.ApiClient Api

<div class="notification">
    <button class="icon-btn" @onclick="ToggleMenu" title="Мэдэгдэл">🔔</button>
    @if (UnreadCount > 0)
    {
        <span class="notification-count">@UnreadCount</span>
    }
    @if (_open)
    {
        <div class="card notification-menu">
            @if (isLoading)
            {
                <div class="notification-item">Loading...</div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="alert alert-danger">@loadError</div>
            }
            else if (notifications.Count == 0)
            {
                <div class="notification-item">No notifications found.</div>
            }
            else
            {
                @foreach (var notification in notifications)
                {
                    <div class="notification-item notification-entry @(notification.IsRead ? "read" : "unread")">
                        <div>
                            <strong>@notification.Title</strong>
                            <div class="muted">@notification.CreatedAt.ToLocalTime()</div>
                        </div>
                        @if (!notification.IsRead)
                        {
                            <button class="btn btn-link btn-sm p-0" @onclick="() => MarkAsReadAsync(notification.Id)">Mark read</button>
                        }
                    </div>
                }
            }
            <div class="d-flex gap-2 mt-3">
                <a href="/notifications" class="btn btn-sm btn-outline-primary">View all</a>
                @if (UnreadCount > 0)
                {
                    <button class="btn btn-sm btn-primary" @onclick="MarkAllReadAsync">Mark all read</button>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool _open;
    private bool isLoading;
    private string? loadError;
    private int UnreadCount;
    private IReadOnlyList<NotificationDto> notifications = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadUnreadCountAsync();
    }

    private async Task ToggleMenu()
    {
        _open = !_open;
        if (_open)
        {
            await LoadAsync();
        }
    }

    private async Task LoadUnreadCountAsync()
    {
        try
        {
            var unread = await Api.GetUnreadNotificationCountAsync();
            UnreadCount = unread?.Count ?? 0;
        }
        catch
        {
            // Fail silently for count load so header still renders.
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;
            await LoadUnreadCountAsync();
            notifications = await Api.GetRecentNotificationsAsync(5);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task MarkAsReadAsync(Guid id)
    {
        try
        {
            await Api.MarkNotificationReadAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private async Task MarkAllReadAsync()
    {
        foreach (var notification in notifications.Where(n => !n.IsRead))
        {
            await Api.MarkNotificationReadAsync(notification.Id);
        }

        await LoadAsync();
    }
}

