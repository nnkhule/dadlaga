@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData">
            <NotAuthorized>
                @{
                    // Redirect unauthenticated/unauthorized users to login.
                    // Rendering a static "loading" div here caused an infinite re-render
                    // because CascadingAuthenticationState kept notifying state changes while
                    // the component was mounted and the static content kept Blazor in a dirty
                    // render cycle.  Using NavigateTo with replace:true breaks the loop.
                    Navigation.NavigateTo("/login", replace: true);
                }
            </NotAuthorized>
            <Authorizing>
                <div style="padding: 2rem; text-align: center;">
                    <p>Шалгаж байна...</p>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <div style="padding: 2rem;">
            <h3>Хуудас олдсонгүй</h3>
            <p>Таны хайлж буй хуудас байхгүй байна.</p>
            <a href="/">Нүүр рүү буцах</a>
        </div>
    </NotFound>
</Router>
