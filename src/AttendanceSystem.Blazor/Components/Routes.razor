<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData"
                   DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <p>Уучлаарай, та энэ хуудсыг үзэх эрхгүй байна.</p>
            </NotAuthorized>
            <Authorizing>
                <p>Шалгаж байна...</p>
            </Authorizing>
        </AuthorizeRouteView>
    </Found>

    <NotFound>
        <p>Page not found.</p>
    </NotFound>
</Router>